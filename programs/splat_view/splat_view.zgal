;; splat_view: the viewer (lib/view_graph.zgal's ViewGraph) on a scene (docs/data-format.md), in a
;; window or headless (--frames N), writing the last frame to a PNG (--capture FILE):
;;
;;     build/splat_view/splat_view <scene.stream or scene.ply> [more arguments]
;;
;; The scene streams in over frames (--stream-words a frame) and the GPU decodes each record as it
;; arrives, so the view fills in while it loads. The program's opener (splat_view.cpp natively)
;; opens the file: a scene.stream as it is, or (natively) an INRIA PLY read and encoded in full
;; (f32, its own SH degree) in memory; either way it refuses a header checkStreamHeader refuses,
;; which fails the program before its first frame. The header sizes the graph's buffers.
;;
;; The camera starts as the stream header's, or --camera k of --cameras FILE (a cameras.bin), fitted
;; to the window or --size (lib/view_camera.zgal's fitCamera: with the start camera's size it's the
;; start camera exactly). Until the header has been read back (a few frames) nothing is drawn.
;; The app checks each streamed event (the bytes arrived, a multiple of 4, at most the buffer's) and
;; fails (exit 1) on a bad one, a missing camera or when the frames run out before it has a camera.
;; On the last frame it prints what had arrived and the records that held (the truncated scene a
;; test renders whole to compare with), the frame the stream finished loading in and the frame
;; Project last ran in. --check-decode (implied by --inspect and --decode-ahead-mutant) poisons the
;; stream buffer past what has arrived each frame and reads the counts back every frame: each must
;; show nothing written past the records decoded, and exactly the records the arrived bytes hold
;; decoded (completeRecords), and the header passed. --inspect also reads back accum and the
;; DrawCommand and checks, on the last frame, that the image is Encode's of accum (encodeAccum),
;; within a unit of rounding, and that every splat was decoded (base and SH), sorted and drawn: each
;; count is the header's, and that Project ran as often as the app enabled it (the GPU's
;; viewProjections). The newest readbacks may be of different frames, so this holds for a still,
;; loaded scene only: the run must end still for framesInFlight + 3 frames. Once those pass, it
;; writes accum's readback to the file $SPLAT_VIEW_ACCUM names, if set (an extern can't take a path
;; option), for web-check/view_oracle_check's closed-form oracle (test.sh).
;;
;; Controls (docs/architecture.md, "splat_view"): W, A, S and D move forward, left, back and right,
;; Q and E sink and rise, dragging with the left button looks around, and scrolling changes the
;; speed. A key pressed and released between two frames still moves for one frame (a latched
;; press). Project and the sort run only in a frame whose camera differs from the last projected
;; one (the pose, the size, or the app becoming ready) or that holds more of the stream: their
;; outputs are #:frames shared, so a still, loaded scene reuses them in every frame slot.
;; --scripted-moves, --project-every-frame, --frames-in-flight, --check-decode and
;; --decode-ahead-mutant (lib/stream_check.zgal's DecodeAheadMutant) are for tests.

(import "../../lib/view_graph.zgal")
(import "../../lib/view_camera.zgal")

;; The camera before the app has one (nothing is drawn with it: Project is off)
(define (placeholderCamera) : Camera
  (Camera (mat4 1.0) (vec4 1.0 1.0 0.5 0.5) (vec3 0.0) (uint 0) (uvec2 1 1) (uint 0) (uint 0)))

;; The movement keys, as bits of the app's held and tapped masks
(define keyW (uint 1))
(define keyA (uint 2))
(define keyS (uint 4))
(define keyD (uint 8))
(define keyQ (uint 16))
(define keyE (uint 32))

;; Scrolling: each step scales the speed by viewStepFactor, within viewMaxSteps steps either way
(define viewStepFactor 1.25)
(define viewMaxSteps 20.0)

;; 1 when a key's bit is in the mask, else 0
(define (keyDown [keys : uint] [key : uint]) : float
  (if (= (bitand keys key) (uint 0)) 0.0 1.0))

;; viewMove's keys, (D - A, E - Q, W - S), from a mask
(define (moveKeys [keys : uint]) : vec3
  (vec3 (- (keyDown keys keyD) (keyDown keys keyA))
        (- (keyDown keys keyE) (keyDown keys keyQ))
        (- (keyDown keys keyW) (keyDown keys keyS))))

;; The speed before any scrolling, in world units per second: a quarter of the scene's length a
;; second. With --cameras the length is the spread of the capture's camera centres (readCameras'
;; handler: their root mean square distance from their mean), the scale the capture walked. Without
;; them, or when they don't spread (one camera, or coincident centres), the fallback is the start
;; camera's distance from the world origin (at least 0.04). A Camera carries no scene scale and the stream header no bounds,
;; so the fallback is a guess that holds only for a scene around the origin seen from a scene's
;; length away (the header's default camera of such a scene). It's far off for an off-origin scene
;; or a camera near the origin, where scrolling (x86 at most either way) may not correct it.
;; The spread counts only above a thousandth of the fallback length. Coincident centres don't spread
;; exactly 0 in float32: the rounding in the mean and the differences leaves about 1e-7 of the
;; centres' size, which would freeze the viewer at a speed of ~1e-8. The fallback is at least the
;; start camera's distance, a centre's size, so a thousandth of it is far above that residue and far
;; below any real capture's baseline.
(define (viewFallbackLength [start : Camera]) : float
  (max (length start.center) 0.04))
(define (viewSpreads [spread : float] [start : Camera]) : bool
  (> spread (* 0.001 (viewFallbackLength start))))
(define (viewBaseSpeed [spread : float] [start : Camera]) : float
  (* 0.25 (if (viewSpreads spread start) spread (viewFallbackLength start))))

;; Whether two poses are the same, exactly (so a pose that moved, however little, differs)
(define (samePose [a : ViewPose] [b : ViewPose]) : bool
  (and (= a.offset.x b.offset.x) (= a.offset.y b.offset.y) (= a.offset.z b.offset.z) (= a.yaw b.yaw)
       (= a.pitch b.pitch)))

;; A mouse delta in pixels from two cursors (in [-1, 1] across the surface, y down)
(define (cursorPixels [from : vec2] [to : vec2] [size : vec2]) : vec2
  (* (* (- to from) size) 0.5))

;; The look sensitivity: a pixel of the fitted camera's image per radian at its centre (1 / fy),
;; so a drag turns the scene under the cursor about as far as the cursor went
(define (radiansPerPixel [start : Camera] [size : vec2]) : float
  (/ (float start.size.y) (* start.intrinsics.y size.y)))

;; A drag's look: the pose turned by the cursor's move from `from` to `to` on a surface of `size`
;; pixels (the cursor-moved handler's, and --scripted-moves')
(define (dragLook [pose : ViewPose] [start : Camera] [from : vec2] [to : vec2] [size : vec2]) : ViewPose
  (viewLook pose (cursorPixels from to size) (radiansPerPixel start size)))

;; An rgba8 readback pixel's channel c (a uint, r in the low byte)
(define (byteChannel [pixel : uint] [c : uint]) : uint
  (bitand (shr pixel (* c (uint 8))) (uint 255)))

;; An rgba16f readback pixel (r | g << 16, b | a << 16) as a vec4
(define (halfPixel [pixel : uvec2]) : vec4
  (vec4 (decodeHalf (bitand pixel.x (uint 65535))) (decodeHalf (shr pixel.x (uint 16)))
        (decodeHalf (bitand pixel.y (uint 65535))) (decodeHalf (shr pixel.y (uint 16)))))

;; The largest difference, over a pixel's colour channels, between the image's bytes and Encode's
;; result for the accum pixel (rounded to bytes)
(define (encodeError [accum : uvec2] [image : uint] [background : vec3]) : uint
  (let* ([expected (encodeAccum (halfPixel accum) background)])
    (fold ([worst (uint 0)]) ([c (range (uint 0) (uint 3))])
      (let* ([want (uint (+ (* (at expected c) 255.0) 0.5))]
             [got (byteChannel image c)])
        (max worst (if (> want got) (- want got) (- got want)))))))

(app SplatView
  (parameter streamFile path)
  (parameter streamWords uint)
  (parameter cameraFile path)
  (parameter hasCameras bool)
  (parameter cameraIndex uint)
  (parameter near float)
  (parameter background float)
  (parameter inspect bool)
  (parameter checkDecode bool)
  (parameter decodeAheadMutant bool)
  ;; Tests: the frame after the app becomes ready, the surface shrinking to three quarters
  ;; (resize!), then scriptedMoves frames moving forward and looking (W and a drag, through the
  ;; controls' code), then still; Project in every frame (a fresh render, to compare the cache
  ;; with); and the frames in flight (from the first frame) when framesGiven
  (parameter scriptedMoves uint)
  (parameter projectEveryFrame bool)
  (parameter framesInFlightOption uint)
  (parameter framesGiven bool)
  ;; Exits the program with status 1
  (extern (fail) : void)
  ;; Writes accum's readback (rgba16f pixels as r | g << 16, b | a << 16, row by row) to the file
  ;; $SPLAT_VIEW_ACCUM names, if set
  (extern (saveAccum [accum : (data uvec2)]) : void)
  (state
   (headerReady bool #f)   ; the header has been read back
   ;; The header's splats and record layout (completeRecords'), once it has been read back
   (splatCount uint 0)
   (baseOffset uint 0)
   (baseStride uint 0)
   (shOffset uint 0)
   (shStride uint 0)
   ;; The stream: the bytes the coming frame holds and the buffer's (the streamed event's), the
   ;; frame it finished loading in, and --check-decode's counts readbacks checked against the header
   (arrived uint 0)
   (total uint 0)
   (loaded bool #f)
   (loadedFrame uint 0)
   (decodeChecks uint 0)
   (cameraReady bool #f)   ; the start camera is known
   (start Camera (placeholderCamera))
   (readyFrame uint 0)     ; the frame both became ready in
   (failed bool #f)
   ;; The controls: where the viewer is, the movement keys held and those pressed since the last
   ;; frame that moved (a latched press), the drag, and the scroll steps
   (pose ViewPose (viewPose))
   (held uint 0)
   (tapped uint 0)
   (dragging bool #f)
   (cursor vec2 (vec2 0.0))
   (steps float 0.0)
   (baseSpeed float 0.0)   ; viewBaseSpeed's, once the start camera is known
   ;; Whether the start camera changed since Project last ran (the app became ready), whether
   ;; this frame runs it, the pose and size it last ran for, how often it has, and in which frame
   (dirty bool #t)
   (project bool #f)
   (projectedPose ViewPose (viewPose))
   (projectedSize vec2 (vec2 0.0))
   (projections uint 0)
   (lastProjectFrame uint 0)
   ;; --inspect: the newest readbacks and the frames they were handled in
   (accum (data uvec2) (empty-data uvec2))
   (accumFrame uint 0)
   (image (data uint) (empty-data uint))
   (imageFrame uint 0)
   (counts (data uint) (empty-data uint))
   (countsFrame uint 0)
   (draws (data DrawCommand) (empty-data DrawCommand))
   (drawsFrame uint 0))
  (on (key-pressed escape) (quit!))
  ;; A key's press sets its bit in both masks, and its release clears it from held only: the frame
  ;; moves with either, so a press released before the frame still moves it
  (on (key-pressed w) (with state #:held (bitor state.held keyW) #:tapped (bitor state.tapped keyW)))
  (on (key-pressed a) (with state #:held (bitor state.held keyA) #:tapped (bitor state.tapped keyA)))
  (on (key-pressed s) (with state #:held (bitor state.held keyS) #:tapped (bitor state.tapped keyS)))
  (on (key-pressed d) (with state #:held (bitor state.held keyD) #:tapped (bitor state.tapped keyD)))
  (on (key-pressed q) (with state #:held (bitor state.held keyQ) #:tapped (bitor state.tapped keyQ)))
  (on (key-pressed e) (with state #:held (bitor state.held keyE) #:tapped (bitor state.tapped keyE)))
  (on (key-released w) (with state #:held (bitand state.held (bitnot keyW))))
  (on (key-released a) (with state #:held (bitand state.held (bitnot keyA))))
  (on (key-released s) (with state #:held (bitand state.held (bitnot keyS))))
  (on (key-released d) (with state #:held (bitand state.held (bitnot keyD))))
  (on (key-released q) (with state #:held (bitand state.held (bitnot keyQ))))
  (on (key-released e) (with state #:held (bitand state.held (bitnot keyE))))
  ;; Dragging with the left button looks around (once the app has its camera)
  (on (mouse-pressed left cursor) (with state #:dragging #t #:cursor cursor))
  (on (mouse-released left cursor) (with state #:dragging #f))
  (on (cursor-moved cursor)
    (if (and state.dragging state.headerReady state.cameraReady (> surfaceSize.y 0.0))
        (with state #:cursor cursor #:pose (dragLook state.pose state.start state.cursor cursor surfaceSize))
        (with state #:cursor cursor)))
  ;; Scrolling up is faster
  (on (scrolled offset)
    (with state #:steps (clamp (+ state.steps offset.y) (- viewMaxSteps) viewMaxSteps)))
  ;; The header PlanDecode copied out (all zeros until a frame holds all of it), read back until
  ;; the app has it. The opener has checked it: this checks the copy again.
  (on (read readHeader d)
    (let* ([h (at d 0)]
           [code (checkStreamHeader h)])
      (cond
        [(or state.headerReady (= h.magic (uint 0))) state]
        [(not= code streamOk)
         (begin (print! "splat_view: FAILED, the stream's header is refused, code " code) (fail) state)]
        [else
         (let* ([cameraReady (or state.cameraReady (not hasCameras))]
                [speed (if hasCameras state.baseSpeed (viewBaseSpeed 0.0 h.camera))])
           (print! "splat_view: " h.splatCount " splats at SH degree " h.shDegree)
           (unless hasCameras (print! "splat_view: base speed " speed " (from the header's camera)"))
           (with state #:headerReady #t #:splatCount h.splatCount #:baseOffset h.baseOffset
                 #:baseStride h.baseStride #:shOffset h.shOffset #:shStride h.shStride
                 #:cameraReady cameraReady #:start (if hasCameras state.start h.camera) #:baseSpeed speed
                 #:readyFrame frameNumber #:dirty #t))])))
  (on (read readCameras d)
    (if (< cameraIndex (count d))
        (let* ([n (count d)]
               [mean (/ (fold ([acc (vec3 0.0)]) ([i (range (uint 0) n)]) (+ acc (.center (at d i))))
                        (float n))]
               [squares (fold ([acc 0.0]) ([i (range (uint 0) n)])
                          (let* ([offset (- (.center (at d i)) mean)]) (+ acc (dot offset offset))))]
               [spread (sqrt (/ squares (float n)))]
               [speed (viewBaseSpeed spread (at d cameraIndex))])
          (if (viewSpreads spread (at d cameraIndex))
              (print! "splat_view: base speed " speed " (the " n " cameras spread " spread ")")
              (print! "splat_view: base speed " speed " (from the start camera's distance: the " n
                      " cameras spread " spread ")"))
          (with state #:cameraReady #t #:start (at d cameraIndex) #:baseSpeed speed
                #:readyFrame frameNumber #:dirty #t))
        (begin (print! "splat_view: FAILED, --camera " cameraIndex " but --cameras holds " (count d))
               (fail) state)))
  (on (read readAccum d) (with state #:accum d #:accumFrame frameNumber))
  ;; --check-decode: every counts readback (of the frame that read `arrived` bytes,
  ;; counts[decodeArrived]) shows no splat written past the records decoded and, once the header
  ;; is known, the header passed and exactly the records arrived holds decoded
  (on (read readCounts d)
    (let* ([next (with state #:counts d #:countsFrame frameNumber)])
      (cond
        [(not (or checkDecode inspect decodeAheadMutant)) next]
        [(< (count d) viewCountsSize)
         (begin (print! "splat_view: FAILED, the counts readback holds " (count d) " counts") (fail) next)]
        [(not= (at d viewUndecoded) (uint 0))
         (begin (print! "splat_view: FAILED, " (at d viewUndecoded) " splats (summed over frames) written past "
                        "the records decoded, at " (at d decodeArrived) " bytes")
                (fail) next)]
        [(not state.headerReady) next]
        [else
         (let* ([arrived (at d decodeArrived)]
                [base (completeRecords arrived state.baseOffset state.baseStride state.splatCount)]
                [sh (completeRecords arrived state.shOffset state.shStride state.splatCount)])
           (if (and (= (at d decodeHeaderState) (uint 1)) (= (at d decodeHeaderCode) streamOk)
                    (= (at d decodeBaseDecoded) base) (= (at d decodeShDecoded) sh))
               (with next #:decodeChecks (+ state.decodeChecks (uint 1)))
               (begin (print! "splat_view: FAILED, at " arrived " bytes the decode has code "
                              (at d decodeHeaderCode) " (state " (at d decodeHeaderState) "), "
                              (at d decodeBaseDecoded) " base and " (at d decodeShDecoded)
                              " SH records decoded, not " base " and " sh)
                      (fail) next)))])))
  ;; Each frame holding more of the stream: what it holds, which Project must see
  (on (streamed stream arrived total)
    (if (or (> arrived total) (not= (remainder arrived (uint 4)) (uint 0)) (<= arrived state.arrived))
        (begin (print! "splat_view: FAILED, the stream gave " arrived " of " total " bytes after "
                       state.arrived)
               (fail) state)
        (with state #:arrived arrived #:total total #:dirty #t #:loaded (= arrived total)
              #:loadedFrame frameNumber)))
  (on (read readDraws d) (with state #:draws d #:drawsFrame frameNumber))
  (on (read readRendered d) (if inspect (with state #:image d #:imageFrame frameNumber) state))
  ;; Each frame: moves the pose by the keys (and the script), then decides whether Project and the
  ;; sort run (state.project, their #:enabled): once ready, when the start camera, the pose or the
  ;; surface's size differs from what they last ran for (whatever changed the pose: a key, a drag
  ;; or the script), or the frame holds more of the stream (dirty). A resize! applies after the
  ;; handlers but before the camera's computed, so a frame resizing projects for its new size; a
  ;; window resized by the user is seen here a frame late, so that one frame draws the old
  ;; projection at the new size. Then the checks, and on the last frame --inspect's.
  (on (frame dt)
    (let* ([ready (and state.headerReady state.cameraReady)]
           [last (and (> frameLimit 0) (>= (+ frameNumber 1) frameLimit))]
           ;; --scripted-moves: the surface shrinks to three quarters in frame readyFrame + 1, and
           ;; frames readyFrame + 2 to scriptEnd move, so the last projection is a move's
           [scripted (> scriptedMoves (uint 0))]
           [shrinkFrame (+ state.readyFrame (uint 1))]
           [scriptEnd (+ shrinkFrame scriptedMoves)]
           [scriptMoving (and scripted ready (> frameNumber shrinkFrame) (<= frameNumber scriptEnd))]
           [shrinking (and scripted ready (= frameNumber shrinkFrame))]
           [size (uvec2 surfaceSize)]
           [smaller (/ (* size (uint 3)) (uint 4))]
           [newSize (if shrinking (vec2 smaller) surfaceSize)]
           ;; The keys held or pressed since the last frame that moved; they move once ready
           [keys (bitor (bitor state.held state.tapped) (if scriptMoving keyW (uint 0)))]
           [direction (moveKeys keys)]
           [moving (and ready (> (length direction) 0.0))]
           [span (* (viewSpeed state.baseSpeed state.steps viewStepFactor) dt)]
           [walked (if moving (viewMove state.pose state.start direction span) state.pose)]
           ;; The script's drag: the cursor 4 and 2 pixels right and down of the centre
           [pose (if scriptMoving
                     (dragLook walked state.start (vec2 0.0) (/ (vec2 8.0 4.0) newSize) newSize)
                     walked)]
           [changed (or state.dirty (not (samePose pose state.projectedPose))
                        (not= newSize.x state.projectedSize.x) (not= newSize.y state.projectedSize.y))]
           [project (and ready (> newSize.y 0.0) (or projectEveryFrame changed))]
           [next (with state #:pose pose #:tapped (if ready (uint 0) state.tapped)
                       #:dirty (and state.dirty (not project)) #:project project
                       #:projectedPose (if project pose state.projectedPose)
                       #:projectedSize (if project newSize state.projectedSize)
                       #:projections (if project (+ state.projections (uint 1)) state.projections)
                       #:lastProjectFrame (if project frameNumber state.lastProjectFrame))])
      (when (and framesGiven (= frameNumber (uint 0))) (set-frames-in-flight! framesInFlightOption))
      (when shrinking (resize! smaller.x smaller.y))
      ;; The last frame: what it holds (the truncated scene it draws), and when it loaded
      (when last
        (print! "splat_view: streamed " state.arrived " of " state.total " bytes, "
                (completeRecords state.arrived state.baseOffset state.baseStride state.splatCount) " base and "
                (completeRecords state.arrived state.shOffset state.shStride state.splatCount) " SH records")
        (if state.loaded
            (print! "splat_view: loaded in frame " state.loadedFrame "; Project ran in " next.projections
                    " frames, the last frame " next.lastProjectFrame)
            (print! "splat_view: still loading (last streamed in frame " state.loadedFrame "); Project ran in "
                    next.projections " frames, the last frame " next.lastProjectFrame)))
      (cond
        [(and last (not ready))
         (begin (print! "splat_view: FAILED, " frameLimit " frames weren't enough to read the header back")
                (fail) next)]
        [(and last (or checkDecode inspect decodeAheadMutant) (= state.decodeChecks (uint 0)))
         (begin (print! "splat_view: FAILED, " frameLimit " frames weren't enough to check a counts readback")
                (fail) next)]
        [(and last scripted (<= frameNumber scriptEnd))
         (begin (print! "splat_view: FAILED, " frameLimit " frames weren't enough for --scripted-moves "
                        scriptedMoves " (ready in frame " state.readyFrame ")")
                (fail) next)]
        [(and last inspect)
         ;; A readback handled in frame f is of a frame after f - framesInFlight - 2, so each must
         ;; be of a frame after Project last ran (with the camera this frame draws from)
         (let* ([settled (+ next.lastProjectFrame framesInFlight (uint 3))]
                [pixels (count state.image)])
           (cond
             [(or (< state.accumFrame settled) (< state.imageFrame settled) (< state.countsFrame settled)
                  (< state.drawsFrame settled))
              (begin (print! "splat_view: FAILED, too few still frames for --inspect's readbacks (accum handled in frame "
                             state.accumFrame ", the image in " state.imageFrame ", counts in " state.countsFrame
                             ", the DrawCommand in " state.drawsFrame ", Project last ran in "
                             next.lastProjectFrame ")")
                     (fail) next)]
             [(or (< (count state.counts) viewCountsSize) (= (count state.draws) (uint 0)))
              (begin (print! "splat_view: FAILED, --inspect's readbacks hold " (count state.counts) " counts and "
                             (count state.draws) " DrawCommands")
                     (fail) next)]
             [(not (and (= (at state.counts decodeBaseDecoded) state.splatCount)
                        (= (at state.counts decodeShDecoded) state.splatCount)
                        (= (at state.counts viewProjected) state.splatCount)
                        (= (.instanceCount (at state.draws 0)) state.splatCount)
                        (= (.vertexCount (at state.draws 0)) (uint 6))))
              (begin (print! "splat_view: FAILED, not every splat drawn: " (at state.counts decodeBaseDecoded)
                             " base and " (at state.counts decodeShDecoded) " SH records decoded, "
                             (at state.counts viewProjected) " sorted, " (.instanceCount (at state.draws 0))
                             " instances of " (.vertexCount (at state.draws 0)) " vertices drawn, of "
                             state.splatCount " splats")
                     (fail) next)]
             [(not= (at state.counts viewProjections) next.projections)
              (begin (print! "splat_view: FAILED, Project ran in " (at state.counts viewProjections)
                             " frames on the GPU, but the app enabled it in " next.projections)
                     (fail) next)]
             [(or (= pixels (uint 0)) (not= (count state.accum) pixels))
              (begin (print! "splat_view: FAILED, --inspect's readbacks hold " (count state.accum) " and " pixels
                             " pixels")
                     (fail) next)]
             [else
              (let* ([worst (fold ([acc (uint 0)]) ([i (range (uint 0) pixels)])
                              (max acc (encodeError (at state.accum i) (at state.image i) (vec3 background))))]
                     [covered (fold ([acc (uint 0)]) ([i (range (uint 0) pixels)])
                                (if (> (.w (halfPixel (at state.accum i))) 0.0) (+ acc (uint 1)) acc))])
                (print! "splat_view: inspect: Project ran in " next.projections " frames (the last, frame "
                        next.lastProjectFrame "); " covered " of " pixels " pixels covered, the image within "
                        worst " of Encode's")
                (if (and (<= worst (uint 1)) (> covered (uint 0)))
                    (begin (saveAccum state.accum) (print! "splat_view: passed") next)
                    (begin (print! "splat_view: FAILED, the image isn't Encode's of accum") (fail) next)))]))]
        [else next])))
  (run ViewGraph (streamFile streamFile) (perFrame (* streamWords (uint 4))) (arrived state.arrived)
       (hasCameras hasCameras) (cameraFile cameraFile)
       (cameraInput (if (and state.headerReady state.cameraReady (> surfaceSize.y 0.0))
                        (fitCamera state.pose state.start (uvec2 surfaceSize))
                        state.start))
       (near near) (background (vec3 background))
       (window (not headless)) (capture capture) (inspect inspect)
       (checkDecode (or checkDecode inspect decodeAheadMutant))
       (decodeAheadMutant decodeAheadMutant)
       #:enabled ((project state.project) (sortSplats state.project) (readHeader (not state.headerReady)))))

(main SplatView
  (about "Views a splat scene's stream, in a window or headless (--frames N, --capture FILE)")
  (window "splat_view" 800 800)
  (timestep #:max 0.1 #:fixed 0.016)
  (capture readRendered)
  (positional streamFile "the scene: a stream (scene.stream), or natively an INRIA PLY")
  (option streamWords "--stream-words" "the stream's 4-byte words read a frame, at most" #:default 1048576
          #:range (1 16777216))
  (option cameraFile "--cameras" "a cameras.bin to start from (otherwise the stream header's camera)"
          #:default "" #:given hasCameras)
  (option cameraIndex "--camera" "the camera of --cameras to start from" #:default 0)
  (option near "--near" "the near plane" #:default 0.2)
  (option background "--background" "the background's grey level (0 black, 1 white)" #:default 0.0
          #:range (0.0 1.0))
  (flag inspect "--inspect" "also read back accum, the counts and the DrawCommand and check them and the image (tests; implies --check-decode)")
  (flag checkDecode "--check-decode" "tests: poison the stream past what has arrived and check each frame's decode")
  (flag decodeAheadMutant "--decode-ahead-mutant" "tests: decode a word of a record before it has arrived (implies --check-decode, which must fail)")
  (option scriptedMoves "--scripted-moves" "tests: once ready, shrink the surface, then move this many frames"
          #:default 0 #:range (0 1000))
  (flag projectEveryFrame "--project-every-frame" "tests: project and sort in every frame, the camera still or not")
  (option framesInFlightOption "--frames-in-flight" "tests: the frames in flight" #:default 2 #:range (1 4)
          #:given framesGiven)
  (controls "Controls:"
            "  W A S D  move forward, left, back, right"
            "  Q E      sink, rise"
            "  drag     look around (left mouse button)"
            "  scroll   faster (up) or slower (down)"
            "  escape   quit"))
