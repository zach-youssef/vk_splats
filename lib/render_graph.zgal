;; The render graph: per frame, every splat projected for one camera, then each tile's splats front
;; to back (Kerbl et al. 2023, Sec. 6), in four stages:
;;   1. preprocess: projectSplat (lib/splat_math.zgal) per splat, and its tile count;
;;   2. an exclusive scan of the tile counts (each splat's first entry) and their total;
;;   3. tile entries, as many as the GPU's total says (an indirect dispatch the plan kernel sizes):
;;      a sort key (tile, then depth) and the splat's index per tile a splat touches;
;;   4. a sort of the keys, moving the splat indices with them, then each tile's range of entries.
;;   5. rasterize: one 16x16 workgroup per tile blends the tile's entries front to back (Eq. 3) over
;;      a background, in batches loaded into shared memory, into each pixel's colour, final
;;      transmittance and last contributor, and an RGBA8 image;
;; and, with a window, a draw showing the image on the surface. Programs import it,
;; (import "../../lib/render_graph.zgal"), which imports the splat math too.
;;
;; The entries' capacity is the app's, a per-frame input: when a frame has more entries than it
;; holds, the frame keeps the first `capacity` (whole splats in index order, then part of one) and
;; is incomplete, and `counts` (read back each frame) tells the app, which grows the capacity
;; (grownCapacity) for the frames after. The tile counts' total must stay below 2^32 (it's a
;; uint): past that the entries are wrong, but every kernel still stays in its buffers' bounds.
;; The splat count lives on the GPU (`splatCounts`, written once by InitSplatCounts, and by the
;; training graph's densification), so the per-splat kernels read it there and are dispatched
;; indirectly (`splatCommands`): a count that changes on the GPU needs no CPU round trip.
;; Every 1D kernel (preprocess, plan, entries, ranges) loops over its elements by grid stride, so
;; its dispatches stay within maxGroups workgroups (a graph parameter: groupLimit, or less to test
;; the loops). Rasterize is the exception: a 2D dispatch of the tile grid, which maxGroups doesn't
;; cap; the programs' image sides are at most 2896 (the colours' 128 MiB budget), so it's at most
;; 181x181 workgroups, within every device's 65535 a dimension.
;; docs/architecture.md has the stages' contracts.

(import indirect)
(import color)
(import "splat_math.zgal")

;; ---------------------------------------------------------------------------------------------
;; Constants and the capacity
;; ---------------------------------------------------------------------------------------------
;; The tile entry kernels' workgroup size (their `workgroup` clauses say 256 too); the plan kernel
;; sizes their indirect dispatch in these
(define entryGroupSize (uint 256))

;; The preprocess's workgroup size (its `workgroup` clause says 64 too)
(define splatGroupSize (uint 64))

;; The most workgroups a dispatch may have in X on every device: Vulkan's guaranteed
;; maxComputeWorkGroupCount[0], lavapipe's, and WebGPU's default maxComputeWorkgroupsPerDimension.
;; The graph's maxGroups; ZGAL can't query the device's own limit.
(define groupLimit (uint 65535))

;; The workgroups of `size` invocations covering `count` elements, at most maxGroups (at least 1):
;; kernels loop by grid stride over what more would have covered. count + size - 1 mustn't wrap.
(define (groupsFor [count : uint] [size : uint] [maxGroups : uint]) : uint
  (min (/ (+ count (- size (uint 1))) size) (max maxGroups (uint 1))))

;; The most tile entries a frame holds: 2^25, so a buffer of their uint keys is 128 MiB, the most
;; any one binding may be (lavapipe's maxStorageBufferRange, WebGPU's default
;; maxStorageBufferBindingSize; docs/architecture.md)
(define entryCapacityMax (uint 33554432))

;; The capacity after a frame that needed `total` entries: the same when they fit, otherwise
;; total + 25% (so a view needing a few more entries each frame doesn't grow it every frame), at
;; most `most` (below 2^32 - 2^30, so total + 25% can't wrap). Never smaller, and at least 1 (a
;; buffer can't hold nothing).
(define (grownCapacityUpTo [capacity : uint] [total : uint] [most : uint]) : uint
  (cond
    [(<= total capacity) (max capacity (uint 1))]
    [(>= total (- most (/ most (uint 4)))) most]
    [else (+ total (/ total (uint 4)))]))

;; The render graph's: at most entryCapacityMax
(define (grownCapacity [capacity : uint] [total : uint]) : uint
  (grownCapacityUpTo capacity total entryCapacityMax))

;; `counts`, the graph's GPU-side sizes (read back as readCounts), element by element
(define countEntries (uint 0))    ; the entries this frame holds: min(total, capacity), the sort's count
(define countTotal (uint 1))      ; the entries the splats need: the tile counts' sum
(define countCapacity (uint 2))   ; the capacity this frame had
(define countDepthBits (uint 3))  ; depthBitsFor(the tile count): the keys' depth bits
(define countDepthShift (uint 4)) ; depthShift(depth bits, near, far): the keys' depth shift
(define countSize (uint 5))      ; the elements (SplatGraph says 5: it can't use this)

;; `splatCounts`, the splats' GPU-side count (shared between frames), element by element. The
;; render graph uses splatActive only; the training graph's densification the rest.
(define splatActive (uint 0))     ; the splats in use: those at indices [0, splatActive)
(define splatOverflow (uint 1))   ; the splats densification couldn't add for lack of capacity, in all
(define splatSlots (uint 2))      ; the last densification's slot count (2 n + 2): its scan's count
(define splatDensifies (uint 3))  ; the densifications run
(define splatPruned (uint 4))     ; the splats the last densification removed
(define splatAdded (uint 5))      ; the splats the last densification added (clones and splits' second halves)
(define splatCountsSize (uint 6)) ; the elements (the graphs say 6: they can't use this)

;; ---------------------------------------------------------------------------------------------
;; Kernels
;; ---------------------------------------------------------------------------------------------
;; 0. The splat count and the per-splat kernels' indirect dispatch (groupsFor splatGroupSize, at
;; most maxGroups), once, in the graph's first frame: one invocation
(compute-material InitSplatCounts
  (workgroup 1)
  (bindings
   (splatCounts (buffer-array uint write))
   (splatCommands (buffer-array DispatchCommand write)))
  (push (splatCount uint) (maxGroups uint))
  (compute
   (for ([k (range (uint 0) splatCountsSize)])
     (write! (at splatCounts k) (if (= k splatActive) splatCount (uint 0))))
   (write! (at splatCommands 0) (DispatchCommand (groupsFor splatCount splatGroupSize maxGroups) 1 1))))

;; 1. Each splat as the camera sees it, and how many tiles it touches (0 when culled)
(compute-material Preprocess
  (workgroup 64)
  (bindings
   (splats (buffer-array Splat read))
   (cameras (buffer-array Camera read))
   (projected (buffer-array Projected write))
   (tileCounts (buffer-array uint write))
   (splatCounts (buffer-array uint read)))
  (push (cameraIndex uint) (near float) (shDegree uint))
  (compute
   (for ([i (range globalInvocationId.x (at splatCounts splatActive) (* splatGroupSize workgroupCount.x))])
     (let* ([p (projectSplat (at splats i) (at cameras cameraIndex) near shDegree)])
       (write! (at projected i) p)
       (write! (at tileCounts i) p.tileCount)))))

;; 3a. From the total (reduced into counts), how many entries this frame holds, the keys' depth
;; bits and shift, and the entry kernels' indirect dispatch (at most maxGroups): one invocation
(compute-material PlanEntries
  (workgroup 1)
  (bindings
   (counts (buffer-array uint read-write))
   (commands (buffer-array DispatchCommand write)))
  (push (capacity uint) (tileCount uint) (near float) (far float) (maxGroups uint))
  (compute
   (let* ([entries (min (at counts countTotal) capacity)]
          [depthBits (depthBitsFor tileCount)])
     (write! (at counts countEntries) entries)
     (write! (at counts countCapacity) capacity)
     (write! (at counts countDepthBits) depthBits)
     (write! (at counts countDepthShift) (depthShift depthBits near far))
     (write! (at commands 0) (DispatchCommand (groupsFor entries entryGroupSize maxGroups) 1 1)))))

;; 3b. Entry e: the splat whose run of entries holds it (the last whose offset is at most e; culled
;; splats' runs are empty), the tile it is of that splat's rectangle (row by row), and its key.
;; Entries sit at fixed positions (offset + index in the run), so they're the same every run.
;; An entry outside its splat's run (only when the total wrapped past 2^32, so the offsets aren't
;; ascending) gets key 0xFFFFFFFF: wrong, but within every buffer's bounds.
(compute-material EmitEntries
  (workgroup 256)
  (bindings
   (projected (buffer-array Projected read))
   (offsets (buffer-array uint read))
   (counts (buffer-array uint read))
   (entryKeys (buffer-array uint write))
   (entrySplats (buffer-array uint write))
   (splatCounts (buffer-array uint read)))
  (push (gridWidth uint) (near float) (far float))
  (compute
   (let* ([splatCount (at splatCounts splatActive)]
          [entries (at counts countEntries)]
          [depthBits (at counts countDepthBits)]
          [shift (at counts countDepthShift)])
     (for ([e (range globalInvocationId.x entries (* entryGroupSize workgroupCount.x))])
       (let* ([(lo hi) (while ([lo (uint 0)] [hi splatCount])
                         (< lo hi)
                         (let* ([mid (/ (+ lo hi) (uint 2))])
                           (if (<= (at offsets mid) e) (values (+ mid (uint 1)) hi) (values lo mid))))]
              [s (- (max lo (uint 1)) (uint 1))]
              [p (at projected s)]
              [k (- e (at offsets s))])
         (write! (at entrySplats e) s)
         (if (< k p.tileCount)
             (let* ([w (- p.tiles.z p.tiles.x)]
                    [tile (+ (* (+ p.tiles.y (/ k w)) gridWidth) p.tiles.x (remainder k w))])
               (write! (at entryKeys e) (depthKeyShifted tile p.depth depthBits near far shift)))
             (write! (at entryKeys e) (bitnot (uint 0)))))))))

;; 4. Each tile's entries, [start, end) in the sorted keys: an entry starts its tile's range when
;; the entry before it is of another tile, and ends it when the one after it is. Tiles without
;; entries keep the clear's (0, 0). `ranges` holds them as two uints a tile (start at 2t, end at
;; 2t + 1), not a uvec2: different invocations write a tile's start and end, and WGSL lets a store
;; to a vector's component rewrite the whole vector, so on the web the two writes raced (one lost).
;; Keys of no tile (EmitEntries' 0xFFFFFFFF) only occur after a wrapped total; they read as the
;; grid's last tile when the tile count is a power of two, which stays in bounds.
(compute-material TileRanges
  (workgroup 256)
  (bindings
   (entryKeys (buffer-array uint read))
   (counts (buffer-array uint read))
   (ranges (buffer-array uint write)))
  (push (tileCount uint))
  (compute
   (let* ([n (at counts countEntries)]
          [bits (at counts countDepthBits)])
     (for ([e (range globalInvocationId.x n (* entryGroupSize workgroupCount.x))])
       (let* ([tile (keyTile (at entryKeys e) bits)])
         (when (< tile tileCount)
           (when (if (= e (uint 0)) #t (not= tile (keyTile (at entryKeys (- e (uint 1))) bits)))
             (write! (at ranges (* tile (uint 2))) e))
           (when (if (= (+ e (uint 1)) n) #t (not= tile (keyTile (at entryKeys (+ e (uint 1))) bits)))
             (write! (at ranges (+ (* tile (uint 2)) (uint 1))) (+ e (uint 1))))))))))

;; 5. Each tile's pixels, one invocation each in a 16x16 workgroup per tile (Sec. 6): the
;; workgroup loads the tile's entries in batches of rasterBatch splats into shared memory (one entry
;; per invocation), then each pixel blends the batch front to back (Eq. 3), with Appendix C's
;; thresholds as the reference code applies them: a splat whose alpha (opacity times the Gaussian,
;; at most alphaMax) is below alphaMin is skipped, and the splat that would take the transmittance
;; below transmittanceMin isn't blended, nor is any after it. The batch loop goes over the whole
;; range even when every pixel has stopped (a barrier can't sit in a loop whose end depends on
;; shared memory, so there's no whole-tile early exit); a stopped pixel skips its blending.
;; Each pixel in the image writes C + T bg and T (colours), the entry after the last one it blended
;; (lastEntries: the tile's start when none was, so the backward pass walks [start, last) back), and
;; C + T bg clamped to [0, 1] into `rendered`. Pixels past the image's edge (in edge tiles) only
;; help load batches.
(define rasterBatch (uint 256))  ; = the workgroup's invocations; the shared arrays say 256 too
(define alphaMin (/ 1.0 255.0))
(define alphaMax 0.99)
(define transmittanceMin 0.0001)

(compute-material Rasterize
  (workgroup 16 16)
  (bindings
   (projected (buffer-array Projected read))
   (entrySplats (buffer-array uint read))
   (ranges (buffer-array uint read))  ; two uints a tile: TileRanges
   (colours (buffer-array vec4 write))
   (lastEntries (buffer-array uint write))
   (rendered (storage-image write)))
  (push (width uint) (height uint) (background vec3))
  ;; 256 x (8 + 16 + 16) bytes = 10 KB (at most 16 KB: docs/architecture.md)
  (shared
   (batchMeans (array vec2 256))
   (batchConicOpacities (array vec4 256))  ; the conic (a, b, c) and the opacity
   (batchColours (array vec4 256)))        ; the colour (vec4: vec3 arrays pad to 16 bytes anyway)
  (compute
   (let* ([tile (+ (* workgroupId.y workgroupCount.x) workgroupId.x)]
          [tileRange (uvec2 (at ranges (* tile (uint 2))) (at ranges (+ (* tile (uint 2)) (uint 1))))]
          [lane (+ (* localInvocationId.y tileSize) localInvocationId.x)]
          [pixel globalInvocationId.xy]
          [inside (and (< pixel.x width) (< pixel.y height))]
          [centre (+ (vec2 pixel) 0.5)]
          [(t colour last done)
           (fold ([t 1.0] [colour (vec3 0.0)] [last tileRange.x] [done (not inside)])
                 ([start (range tileRange.x tileRange.y rasterBatch)])
             (let* ([e (+ start lane)])
               (when (< e tileRange.y)
                 (let* ([p (at projected (at entrySplats e))])
                   (write! (at batchMeans lane) p.mean)
                   (write! (at batchConicOpacities lane) (vec4 p.conic p.opacity))
                   (write! (at batchColours lane) (vec4 p.colour 0.0))))
               (barrier!)
               (let* ([n (min rasterBatch (- tileRange.y start))]
                      [(k t colour last done)
                       (while ([k (uint 0)] [t t] [colour colour] [last last] [done done])
                         (and (not done) (< k n))
                         (let* ([co (at batchConicOpacities k)]
                                [d (- (at batchMeans k) centre)]
                                [power (- (* -0.5 (+ (* co.x d.x d.x) (* co.z d.y d.y))) (* co.y d.x d.y))]
                                [alpha (min alphaMax (* co.w (exp power)))]
                                ;; power > 0 only from rounding (the conic is positive definite):
                                ;; skipped, as in the reference code
                                [skip (or (> power 0.0) (< alpha alphaMin))]
                                [nextT (* t (- 1.0 alpha))]
                                [stop (and (not skip) (< nextT transmittanceMin))])
                           (if (or skip stop)
                               (values (+ k (uint 1)) t colour last stop)
                               (values (+ k (uint 1)) nextT
                                       (+ colour (* (.rgb (at batchColours k)) (* alpha t)))
                                       (+ start k (uint 1)) #f))))])
                 ;; Every pixel is done with the batch before the next one overwrites it
                 (barrier!)
                 (values t colour last done))))]
          [value (+ colour (* t background))])
     (when inside
       (let* ([index (+ (* pixel.y width) pixel.x)])
         (write! (at colours index) (vec4 value t))
         (write! (at lastEntries index) last)
         (store! rendered (ivec2 pixel) (vec4 (clamp value (vec3 0.0) (vec3 1.0)) 1.0)))))))

;; With a window: the rendered image on the surface, letterboxed (scale: the image's half extents
;; in clip space, at most 1, so its aspect ratio is kept), as two triangles. The image holds the
;; colours the capture writes, which are sRGB-encoded as the training images are. The colours are
;; decoded first, assuming an sRGB surface whose hardware encode gives them back: the web draws
;; through an sRGB view, and native Vulkan picks B8G8R8A8_SRGB when the surface offers it (MoltenVK
;; does), but otherwise the first format, and on a UNORM one the window shows the image darker
;; (docs/architecture.md, a known limitation; ZGAL doesn't tell a shader the surface's format).
(graphics-material Present
  (bindings
   (picture texture)
   (pictureSampler sampler))
  (push (scale vec2))
  (varyings (uv vec2))
  (outputs (color vec4))
  (vertex
   (let* ([corner (at (array vec2 (vec2 0.0 0.0) (vec2 1.0 0.0) (vec2 0.0 1.0)
                             (vec2 0.0 1.0) (vec2 1.0 0.0) (vec2 1.0 1.0))
                      vertexIndex)])
     (results #:position (vec4 (* (- (* corner 2.0) 1.0) scale) 0.0 1.0) #:uv corner)))
  (fragment
   (vec4 (srgbDecode (.rgb (sample picture pictureSampler uv))) 1.0)))

;; The scale Present needs to letterbox a width x height image on a surface of surfaceSize
(define (letterbox [surfaceSize : vec2] [width : uint] [height : uint]) : vec2
  (let* ([ratio (/ (* (float width) surfaceSize.y) (* (float height) (max surfaceSize.x 1.0)))])
    (if (> ratio 1.0) (vec2 1.0 (/ 1.0 ratio)) (vec2 ratio 1.0))))

;; ---------------------------------------------------------------------------------------------
;; The graph
;; ---------------------------------------------------------------------------------------------
(graph SplatGraph
  ;; The scene: splatCount splats in splatFile, a camera (cameraIndex) of cameraFile whose image is
  ;; width x height, and SH bands 0 to shDegree
  (parameter splatCount uint)
  (parameter cameraIndex uint)
  (parameter width uint)
  (parameter height uint)
  (parameter shDegree uint)
  (input splatFile path)
  (input cameraFile path)
  ;; Depths: splats at most `near` from the camera are culled, and the keys quantize depth between
  ;; near and far (0 < near < far; depthKey)
  (parameter near float)
  (parameter far float)
  ;; The most workgroups a dispatch has: groupLimit, or less to test the grid-stride loops
  (parameter maxGroups uint)  ; at least 1 (groupsFor), as in the invocations below
  ;; Whether the graph also reads back its inputs and stages for tests (tile_test)
  (parameter inspect bool)
  ;; The entries' capacity this frame (at least 1; grownCapacity)
  (input capacity (per-frame uint))
  ;; The colour behind the splats (per frame: a graph parameter can't be a vec3)
  (input background (per-frame vec3))
  ;; Whether the graph draws the image on the surface (a program with a window, not headless),
  ;; letterboxed by presentScale (letterbox), and whether it reads the image back (a capture)
  (parameter window bool)
  (parameter capture bool)
  (input presentScale (per-frame vec2))

  (constant gridWidth (/ (+ width 15) 16))
  (constant gridHeight (/ (+ height 15) 16))
  (constant tileCount (* gridWidth gridHeight))

  (buffer-file splats Splat splatFile)
  (buffer-file cameras Camera cameraFile)
  (buffer projected Projected splatCount #:frames per-frame)
  (buffer tileCounts uint splatCount #:frames per-frame)
  (buffer offsets uint splatCount #:frames per-frame)
  (buffer counts uint 5 #:frames per-frame)  ; countSize
  (buffer commands DispatchCommand 1 #:frames per-frame)
  (buffer splatCounts uint 6 #:frames shared)  ; splatCountsSize
  (buffer splatCommands DispatchCommand 1 #:frames shared)
  (buffer entryKeys uint capacity #:frames per-frame)
  (buffer entrySplats uint capacity #:frames per-frame)
  (buffer ranges uint (* tileCount 2) #:frames per-frame)  ; [start, end) a tile: TileRanges
  ;; The rasterizer's outputs, per pixel (row by row): the colour and the final transmittance, and
  ;; the entry after the last one blended
  (buffer colours vec4 (* width height) #:frames per-frame)
  (buffer lastEntries uint (* width height) #:frames per-frame)
  (image rendered rgba8 (fixed width height) #:frames per-frame)
  (sampler nearest #:filter nearest #:address clamp-to-edge)
  (target screen (surface #:clear (0.0 0.0 0.0 1.0) #:depth none) #:when window)

  (material initializing InitSplatCounts splatCounts splatCommands
            #:push ((splatCount splatCount) (maxGroups maxGroups)) #:invocations (1))
  (material preprocessing Preprocess splats cameras projected tileCounts splatCounts
            #:push ((cameraIndex cameraIndex) (near near) (shDegree shDegree)))
  (material planning PlanEntries counts commands
            #:push ((capacity capacity) (tileCount tileCount) (near near) (far far)
                    (maxGroups maxGroups))
            #:invocations (1))
  (material emitting EmitEntries projected offsets counts entryKeys entrySplats splatCounts
            #:push ((gridWidth gridWidth) (near near) (far far)))
  (material ranging TileRanges entryKeys counts ranges #:push ((tileCount tileCount)))
  (material rasterizing Rasterize projected entrySplats ranges colours lastEntries rendered
            #:push ((width width) (height height) (background background))
            #:invocations ((* gridWidth 16) (* gridHeight 16)))  ; 16: tileSize, a workgroup a tile
  (material presenting Present (picture rendered) (pictureSampler nearest)
            #:push ((scale presentScale)) #:when window)

  (dispatch initSplats initializing #:once #t)
  (dispatch preprocess preprocessing #:indirect (at splatCommands 0))
  (exclusive-scan scanTileCounts tileCounts offsets #:op add #:count splatCount)
  (reduce totalTileCounts tileCounts (at counts 1) #:op add #:count splatCount)
  (dispatch plan planning)
  (dispatch emit emitting #:indirect (at commands 0))
  (sort sortEntries entryKeys #:values entrySplats #:count (at counts 0))
  (clear clearRanges ranges)
  (dispatch findRanges ranging #:indirect (at commands 0))
  (dispatch rasterize rasterizing)
  (draw present screen presenting 6 #:when window)

  ;; The sizes, each frame, for the app's capacity
  (readback readCounts counts)
  ;; What tests check
  (readback readSplats splats #:once #t #:when inspect)
  (readback readCameras cameras #:once #t #:when inspect)
  (readback readProjected projected #:when inspect)
  (readback readEntryKeys entryKeys #:when inspect)
  (readback readEntrySplats entrySplats #:when inspect)
  (readback readRanges ranges #:when inspect)
  (readback readColours colours #:when inspect)
  (readback readLastEntries lastEntries #:when inspect)
  ;; The image, for a capture
  (readback readRendered rendered #:when capture))
