;; splat_train: trains a scene's splats against its images (lib/train_graph.zgal's TrainGraph, one
;; Adam iteration a frame), scores the held-out views, and writes the trained splats as an INRIA
;; PLY. ZGAL can't read the manifest or join paths, so tools/scene_args.py prints the arguments:
;;
;;     build/splat_train/splat_train $(tools/scene_args.py --train <scene dir>) --max-splats 100000 \
;;         --max-screen-size 20 --iterations 2000 --frames 2100
;;
;; --max-splats (required) is the splat buffers' capacity, at least the scene's splats: the graph
;; holds the count in use on the GPU (densification changes it), and only the first ones are
;; trained and written. --max-screen-size (required) is the screen-space prune's radius in pixels
;; (20, as the reference's code means to; 0, none, as it does: its prune never fires).
;; The phases, one graph throughout:
;;   0. loading: the graph's first frames read the cameras back (Adam and the loss history off;
;;      they render camera 0 at 16x16, or less within --max-width x --max-height);
;;      the app then checks them against the arguments (the camera count, the sizes, a single
;;      image batch, the targets' size, --max-splats >= --splat-count) and splits them, by their heldOut, into training and test
;;      views (cameras without an image are neither);
;;   1. training: iteration t (1-based) renders a training camera, popped at random from a stack
;;      of them refilled when empty (the reference's order; the pick is pcgHash of the seed and
;;      t, the same on every platform), takes its loss's gradients ((1 - --lambda-dssim) L1 +
;;      --lambda-dssim D-SSIM, Sec. 7's, lambda 0.2; 0 is L1 alone) and steps Adam with the
;;      reference's learning rates (the position's decays log-linearly from --position-lr to
;;      --position-lr-final over --position-lr-steps, times --extent) at SH degree
;;      min(--sh-degree, t / --sh-interval). Record writes its loss into history[t - 1].
;;      Densification, as the reference's schedule: when --densify-from < t < --densify-until and
;;      t is a multiple of --densify-interval, the frame densifies (lib/train_graph.zgal's stage
;;      12: threshold --densify-threshold, clone scale --percent-dense x --extent, prune scale
;;      0.1 x --extent and radius --max-screen-size; the size prunes once t > --reset-interval;
;;      a new seed each time) instead of stepping Adam (the reference's step finds no gradients on
;;      the new tensors, so it does nothing), and Adam's bias corrections count the steps taken. When t < --densify-until is
;;      a multiple of --reset-interval (or t = --densify-from with a white background), the
;;      frame also resets the opacity. Each densification's counts are printed as they're read.
;;   2. evaluating: each test view renders once with lossEval (its MSE on the clamped render) and
;;      the backward pass and Adam off, into history[iterations + k];
;;   3. reading: with Adam and Record off, the history, the splat counts (once they show every
;;      densification) and the trained splats are read back; the app prints the first and last
;;      epochs' mean training loss (an epoch is as many iterations as there are training views),
;;      each test view's PSNR and their mean and the splats in use, and writes those splats as
;;      the PLY (exportPly: to $SPLAT_TRAIN_PLY, splat_train.ply by default), then quits.
;; The tile entries' capacity starts at --initial-entries and grows (grownTrainCapacity) after a
;; frame that needed more, from the counts read back after iteration 1's frame (counting); Adam
;; skips a frame that overflowed (its gradients are incomplete), so that iteration is lost (its
;; history is -1) and the program counts and reports it. A frame needing more than
;; trainEntryCapacityMax entries, which no growth can hold, fails the program, as do frames
;; (--frames) running out before the end and an overflowing test view: each test view renders
;; once, so one needing more entries than the training views grew the capacity to isn't retried
;; (the message names the most a frame needed, for --initial-entries). On the web a tick's reads
;; apply before its frame event, so iteration 1's own counts are dropped: with --iterations 1, an
;; overflowing or over-cap iteration 1 neither grows the capacity nor fails the run, it is only
;; reported as skipped (a later pick of the same view is checked, so any longer run is covered).

(import "../../lib/train_graph.zgal")
(import random)

(define phaseLoading (uint 0))
(define phaseTraining (uint 1))
(define phaseEvaluating (uint 2))
(define phaseReading (uint 3))

;; Whether this frame runs a training iteration (the frame that leaves loading runs none: it has no
;; step yet)
(define (iterating [phase : uint] [t : uint]) : bool
  (and (= phase phaseTraining) (> t (uint 0))))

;; Whether iteration t densifies (the reference's: from < t < until, every interval)
(define (densifying [t : uint] [from : uint] [until : uint] [interval : uint]) : bool
  (and (> t from) (< t until) (= (remainder t (max interval (uint 1))) (uint 0))))

;; Whether iteration t resets the opacity (the reference's: every interval before until, and at
;; from with a white background)
(define (resetting [t : uint] [from : uint] [until : uint] [interval : uint] [white : bool]) : bool
  (and (> t (uint 0)) (< t until) (or (= (remainder t (max interval (uint 1))) (uint 0)) (and white (= t from)))))

;; Whether the entry counts read back now are acted on: not until training's first iteration is
;; under way, so loading's frames (which train nothing) don't grow the capacity and iteration 1 runs
;; at --initial-entries whichever order a platform delivers reads and frames in (test.sh's small
;; capacity overflows it: a skip it checks)
(define (counting [phase : uint] [t : uint]) : bool
  (not (or (= phase phaseLoading) (and (= phase phaseTraining) (<= t (uint 1))))))

;; The reference's position learning rate at step t (get_expon_lr_func without a delay):
;; log-linear from init to final over steps, then final
(define (decayedLr [t : uint] [init : float] [final : float] [steps : uint]) : float
  (let* ([s (min (/ (float t) (float (max steps (uint 1)))) 1.0)])
    (exp (+ (* (log init) (- 1.0 s)) (* (log final) s)))))

;; A history slot's loss for a sum, and whether it holds one (Adam skipped a slot holding -1)
(define (heldLoss [x : float]) : float (max x 0.0))
(define (held [x : float]) : float (if (>= x 0.0) 1.0 0.0))

;; A mean of the held losses (from their sum and count), or -1 with none
(define (meanOf [sum : float] [n : float]) : float (if (> n 0.0) (/ sum n) -1.0))

;; The PSNR of an image's MSE on [0, 1] values
(define (psnr [mse : float]) : float
  (* 10.0 (/ (log (/ 1.0 (max mse 1e-30))) (log 10.0))))

;; Whether a float is finite (false for NaN, whose comparisons are all false)
(define (finite [x : float]) : bool (< (abs x) 1e30))

;; Whether every float of a splat is finite
(define (finiteSplat [s : Splat]) : bool
  (and (finite s.position.x) (finite s.position.y) (finite s.position.z) (finite s.opacity)
       (finite s.logScale.x) (finite s.logScale.y) (finite s.logScale.z)
       (finite s.rotation.x) (finite s.rotation.y) (finite s.rotation.z) (finite s.rotation.w)
       (fold ([ok #t]) ([k (range (uint 0) (uint 48))]) (and ok (finite (at s.sh k))))))

(app SplatTrain
  (parameter splatFile path)
  (parameter cameraFile path)
  (parameter targetFile path)
  (parameter splatCount uint)
  (parameter maxSplats uint)
  (parameter cameraCount uint)
  (parameter maxWidth uint)
  (parameter maxHeight uint)
  (parameter targetPixels uint)
  (parameter shDegree uint)
  (parameter near float)
  (parameter far float)
  (parameter initialEntries uint)
  (parameter background float)
  (parameter lambdaDssim float)
  (parameter iterations uint)
  (parameter seed uint)
  (parameter extent float)
  (parameter shInterval uint)
  (parameter positionLrInit float)
  (parameter positionLrFinal float)
  (parameter positionLrSteps uint)
  (parameter featureLr float)
  (parameter opacityLr float)
  (parameter scalingLr float)
  (parameter rotationLr float)
  (parameter densifyFrom uint)
  (parameter densifyUntil uint)
  (parameter densifyInterval uint)
  (parameter densifyThreshold float)
  (parameter percentDense float)
  (parameter resetInterval uint)
  (parameter maxScreenSize uint)
  (parameter maxScreenSizeGiven bool)
  ;; Writes the splats as an INRIA PLY (to $SPLAT_TRAIN_PLY, or splat_train.ply)
  (extern (exportPly [splats : (data Splat)]) : void)
  ;; Exits the program with status 1
  (extern (fail) : void)
  (state
   (phase uint phaseLoading)
   (cameras (data Camera) (empty-data Camera))
   (train (data uint) (empty-data uint))      ; the training views
   (test (data uint) (empty-data uint))       ; the held-out views
   (stack (data uint) (empty-data uint))      ; the training views this epoch hasn't popped
   ;; This frame's work: the camera, and in training its iteration t (1-based), in evaluation its
   ;; test view's index
   (camera uint 0)
   (iteration uint 0)
   (view uint 0)
   (capacity uint (grownTrainCapacity initialEntries 0))
   (mostEntries uint 0)
   (history (data float) (empty-data float))
   (trained (data Splat) (empty-data Splat))
   ;; The densifications run so far (Adam's steps are the iterations less these), the newest
   ;; splat counts read, and the densifications already printed
   (densifications uint 0)
   (counts (data uint) (empty-data uint))
   (reported uint 0))
  (on (read readCameras d)
    (if (= state.phase phaseLoading) (with state #:cameras d) state))
  (on (read readCounts d)
    (if (not (counting state.phase state.iteration))
        state
        (let* ([total (at d countTotal)]
               [grown (grownTrainCapacity state.capacity total)])
          (when (> total trainEntryCapacityMax)
            (print! "splat_train: FAILED, a frame needs " total " tile entries, more than training's cap of "
                    trainEntryCapacityMax " (trainEntryCapacityMax: its entry gradients must fit in one binding)")
            (fail))
          (when (not= grown state.capacity)
            (print! "splat_train: a frame needed " total " tile entries, more than its capacity of " state.capacity
                    "; growing it to " grown))
          (with state #:capacity grown #:mostEntries (max state.mostEntries total)))))
  (on (read readHistory d)
    (if (= state.phase phaseReading) (with state #:history d) state))
  (on (read readTrained d)
    (if (= state.phase phaseReading) (with state #:trained d) state))
  (on (read readSplatCounts d)
    (begin
      (when (> (at d splatDensifies) state.reported)
        (print! "splat_train: densification " (at d splatDensifies) ": " (at d splatActive) " splats ("
                (at d splatPruned) " pruned, " (at d splatAdded) " added; " (at d splatOverflow)
                " dropped for --max-splats so far)"))
      (with state #:counts d #:reported (max state.reported (at d splatDensifies)))))
  (on (frame dt)
    (cond
      [(and (> frameLimit 0) (>= (+ frameNumber 1) frameLimit))
       (begin
         (print! "splat_train: FAILED, " frameLimit " frames weren't enough (phase " state.phase ", iteration "
                 state.iteration " of " iterations ")")
         (fail)
         state)]
      ;; 0: check the cameras once they've arrived, then start training
      [(= state.phase phaseLoading)
       (if (= (count state.cameras) 0)
           state
           (let* ([cams state.cameras]
                  [imaged (collect ([i (range (uint 0) (count cams))]) i
                            #:when (not= (.imageBatch (at cams i)) (uint 4294967295)))]
                  [train (collect ([i imaged]) i #:when (= (.heldOut (at cams i)) (uint 0)))]
                  [test (collect ([i imaged]) i #:when (not= (.heldOut (at cams i)) (uint 0)))]
                  [batched (fold ([ok #t]) ([j (range (uint 0) (count imaged))])
                             (and ok (= (.imageBatch (at cams (at imaged j))) (uint 0))))]
                  [sized (fold ([ok #t]) ([j (range (uint 0) (count imaged))])
                           (let* ([c (at cams (at imaged j))])
                             (and ok (<= c.size.x maxWidth) (<= c.size.y maxHeight)
                                  (<= c.pixelOffset targetPixels)
                                  (<= (* c.size.x c.size.y) (- targetPixels c.pixelOffset)))))])
             (cond
               [(not= (count cams) cameraCount)
                (begin (print! "splat_train: FAILED, the cameras file holds " (count cams) " cameras, not --camera-count "
                               cameraCount)
                       (fail) state)]
               [(< maxSplats splatCount)
                (begin (print! "splat_train: FAILED, --max-splats " maxSplats " is below --splat-count " splatCount)
                       (fail) state)]
               [(not maxScreenSizeGiven)
                (begin (print! "splat_train: FAILED, --max-screen-size is required: 20 prunes as the reference "
                               "means to, 0 as it does (paper-conformance.md, departure 12)")
                       (fail) state)]
               [(not batched)
                (begin (print! "splat_train: FAILED, the images span several batches (images_<k>.bin); training reads one")
                       (fail) state)]
               [(not sized)
                (begin (print! "splat_train: FAILED, a camera is larger than --max-width x --max-height, or its "
                               "image lies past --target-pixels " targetPixels)
                       (fail) state)]
               [(= (count train) 0)
                (begin (print! "splat_train: FAILED, the scene has no training view (a camera with an image, not held out)")
                       (fail) state)]
               [else
                (begin
                  (print! "splat_train: " splatCount " splats, " (count train) " training views, " (count test)
                          " held out; " iterations " iterations")
                  (with state #:phase phaseTraining #:train train #:test test #:stack train #:camera (at train 0)))])))]
      ;; 1: the next iteration, or the first test view (or reading, without one)
      [(and (= state.phase phaseTraining) (< state.iteration iterations))
       (let* ([t (+ state.iteration (uint 1))]
              [pool (if (= (count state.stack) (uint 0)) state.train state.stack)]
              [pick (remainder (pcgHash (+ (pcgHash seed) t)) (count pool))])
         (with state #:iteration t #:camera (at pool pick)
               #:densifications (+ state.densifications
                                   (if (densifying t densifyFrom densifyUntil densifyInterval) (uint 1) (uint 0)))
               #:stack (collect ([j (range (uint 0) (count pool))]) (at pool j) #:when (not= j pick))))]
      [(and (or (= state.phase phaseTraining) (= state.phase phaseEvaluating))
            (< (if (= state.phase phaseTraining) (uint 0) (+ state.view (uint 1))) (count state.test)))
       (let* ([view (if (= state.phase phaseTraining) (uint 0) (+ state.view (uint 1)))])
         (with state #:phase phaseEvaluating #:view view #:camera (at state.test view)))]
      [(not= state.phase phaseReading) (with state #:phase phaseReading)]
      ;; 3: once the history, the counts after every densification and the splats have arrived,
      ;; report and write them
      [(and (= (count state.history) (+ iterations cameraCount)) (> (count state.counts) splatAdded)
            (= (at state.counts splatDensifies) state.densifications)
            (>= (count state.trained) (at state.counts splatActive)))
       (let* ([h state.history]
              ;; The buffer holds --max-splats; the splats in use are its first ones
              [inUse (at state.counts splatActive)]
              [trained (collect ([i (range (uint 0) inUse)]) (at state.trained i))]
              [epoch (min (count state.train) iterations)]
              [first (meanOf (fold ([a 0.0]) ([i (range (uint 0) epoch)]) (+ a (heldLoss (at h i))))
                             (fold ([a 0.0]) ([i (range (uint 0) epoch)]) (+ a (held (at h i)))))]
              [last (meanOf (fold ([a 0.0]) ([i (range (- iterations epoch) iterations)]) (+ a (heldLoss (at h i))))
                            (fold ([a 0.0]) ([i (range (- iterations epoch) iterations)]) (+ a (held (at h i)))))]
              [skipped (fold ([k (uint 0)]) ([i (range (uint 0) iterations)])
                         (if (< (at h i) 0.0) (+ k (uint 1)) k))]
              [overflowedViews (fold ([k (uint 0)]) ([v (range (uint 0) (count state.test))])
                                 (if (< (at h (+ iterations v)) 0.0) (+ k (uint 1)) k))]
              [meanPsnr (if (> (count state.test) (uint 0))
                            (/ (fold ([a 0.0]) ([v (range (uint 0) (count state.test))]) (+ a (psnr (at h (+ iterations v)))))
                               (float (count state.test)))
                            0.0)]
              [lossesFinite (fold ([ok #t]) ([i (range (uint 0) (+ iterations (count state.test)))])
                              (and ok (finite (at h i))))]
              [splatsFinite (fold ([ok #t]) ([i (range (uint 0) (count trained))])
                              (and ok (finiteSplat (at trained i))))])
         (for ([v (range (uint 0) (count state.test))])
           (print! "splat_train: test view " (at state.test v) " PSNR " (psnr (at h (+ iterations v))) " dB"))
         (if (> lambdaDssim 0.0)
             (print! "splat_train: training loss ((1 - " lambdaDssim ") L1 + " lambdaDssim " D-SSIM) first epoch " first ", last epoch " last ", ratio "
                     (/ first (max last 1e-30)))
             (print! "splat_train: training loss (L1) first epoch " first ", last epoch " last ", ratio "
                     (/ first (max last 1e-30))))
         (print! "splat_train: held-out PSNR " meanPsnr " dB over " (count state.test) " views")
         (print! "splat_train: " skipped " iterations skipped (overflowed), the most tile entries a frame needed "
                 state.mostEntries)
         (print! "splat_train: " inUse " splats in use (from " splatCount ", at most " maxSplats "), "
                 state.densifications " densifications, " (at state.counts splatOverflow)
                 " additions dropped for --max-splats")
         (exportPly trained)
         (cond
           [(not (and lossesFinite splatsFinite))
            (begin (print! "splat_train: FAILED, a loss or a trained splat isn't finite") (fail))]
           [(> overflowedViews (uint 0))
            (begin (print! "splat_train: FAILED, " overflowedViews " test views overflowed their tile entries; rerun with "
                           "--initial-entries " (grownTrainCapacity state.capacity state.mostEntries)
                           " (the most a frame was seen to need: " state.mostEntries ")")
                   (fail))]
           [else (quit!)])
         state)]
      [else state]))
  (run TrainGraph (splatFile splatFile) (cameraFile cameraFile) (targetFile targetFile)
       (splatCount splatCount) (maxSplats (max maxSplats splatCount)) (maxWidth maxWidth) (maxHeight maxHeight)
       (cameraIndex state.camera)
       (width (if (= state.phase phaseLoading) (min (uint 16) maxWidth) (.x (.size (at state.cameras state.camera)))))
       (height (if (= state.phase phaseLoading) (min (uint 16) maxHeight) (.y (.size (at state.cameras state.camera)))))
       (targetOffset (if (= state.phase phaseLoading) (uint 0) (.pixelOffset (at state.cameras state.camera))))
       (targetPixels targetPixels)
       (shDegree (min shDegree (/ (if (= state.phase phaseTraining) state.iteration iterations) (max shInterval (uint 1)))))
       (near near) (far far) (maxGroups groupLimit) (inspect #f) (finiteDifferences #f)
       (capacity state.capacity) (background (vec3 background))
       (loss (if (= state.phase phaseTraining) lossL1 lossEval))
       (dssim (> lambdaDssim 0.0)) (dssimWeight lambdaDssim)
       (probe 0) (perturbSplat 0) (perturbField perturbNone) (perturbDelta 0.0)
       (train #t) (historySize (+ iterations cameraCount))
       (historySlot (if (= state.phase phaseTraining) (- state.iteration (uint 1)) (+ iterations state.view)))
       ;; Adam's steps so far: the iterations less the densifications (which don't step)
       (bias1 (- 1.0 (pow 0.9 (float (max (- state.iteration state.densifications) (uint 1))))))
       (bias2 (- 1.0 (pow 0.999 (float (max (- state.iteration state.densifications) (uint 1))))))
       (positionLr (* (decayedLr state.iteration positionLrInit positionLrFinal positionLrSteps) extent))
       (dcLr featureLr) (restLr (/ featureLr 20.0)) (opacityLr opacityLr) (scalingLr scalingLr)
       (rotationLr rotationLr)
       ;; The densification's: the reference's percent_dense x extent and 0.1 x extent; the size
       ;; prunes after the first reset; a seed for each densification
       (densifyThreshold densifyThreshold) (cloneScale (* percentDense extent)) (pruneScale (* 0.1 extent))
       (screenPrune (if (> state.iteration resetInterval) (uint 1) (uint 0))) (maxScreenSize maxScreenSize)
       (densifySeed (pcgHash (+ (pcgHash (+ seed (uint 1))) state.iteration)))
       #:enabled ((findLasts (iterating state.phase state.iteration))
                  (backwardRasterize (iterating state.phase state.iteration))
                  (clearPositions (iterating state.phase state.iteration))
                  (invert (iterating state.phase state.iteration))
                  (gather (iterating state.phase state.iteration))
                  (backwardPreprocess (iterating state.phase state.iteration))
                  (adam (and (iterating state.phase state.iteration)
                             (not (densifying state.iteration densifyFrom densifyUntil densifyInterval))))
                  (record (or (iterating state.phase state.iteration) (= state.phase phaseEvaluating)))
                  (densifyPrepare (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyMark (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyScan (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyCopySplats (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyScatter (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyCopyFirstMoments (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyScatterFirst (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyCopySecondMoments (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyScatterSecond (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyFinish (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (densifyClear (and (iterating state.phase state.iteration) (densifying state.iteration densifyFrom densifyUntil densifyInterval)))
                  (resetOpacity (and (iterating state.phase state.iteration)
                                     (resetting state.iteration densifyFrom densifyUntil resetInterval
                                                (>= background 1.0))))
                  (readHistory (= state.phase phaseReading))
                  (readTrained (= state.phase phaseReading)))))

(main SplatTrain
  (about "Trains a splat scene against its images (one Adam iteration a frame), scores its held-out views and writes a PLY")
  (timestep #:max 0.1 #:fixed 0.016)
  (option splatFile "--splats" "the scene's splats.bin (trained in place on the GPU; the file isn't written)"
          #:default "splats.bin")
  (option cameraFile "--cameras" "the scene's cameras.bin" #:default "cameras.bin")
  (option targetFile "--targets" "the scene's images (its only images_<k>.bin)" #:default "images_0.bin")
  (option splatCount "--splat-count" "the splats in it (the manifest's splatCount)" #:default 1
          #:range (1 16777216))
  ;; Required (0 fails loading): the cap is a trade-off between memory and how far densification
  ;; may grow the scene. At most 559240 (the 128 MiB binding budget / 240 B a splat)
  (option maxSplats "--max-splats" "the most splats training may hold (densification's cap; required, at least --splat-count, at most 559240)"
          #:default 0 #:range (0 559240))
  (option cameraCount "--camera-count" "the cameras in it (the manifest's cameraCount)" #:default 1
          #:range (1 65536))
  ;; At most 2896 a side, as splat_render's (the 128 MiB binding budget)
  (option maxWidth "--max-width" "the widest camera's width (at most 2896: the 128 MiB binding budget)"
          #:default 64 #:range (1 2896))
  (option maxHeight "--max-height" "the tallest camera's height (at most 2896: the 128 MiB binding budget)"
          #:default 64 #:range (1 2896))
  (option targetPixels "--target-pixels" "the pixels the images hold (the file's size / 4)" #:default 0)
  (option shDegree "--sh-degree" "the SH degree training reaches" #:default 3 #:range (0 3))
  (option near "--near" "the near plane" #:default 0.2)
  (option far "--far" "the depth keys' far depth" #:default 1000.0)
  (option initialEntries "--initial-entries" "the tile entries' first capacity" #:default 1048576
          #:range (1 3145728))
  (option lambdaDssim "--lambda-dssim" "the D-SSIM term's weight in the training loss (the paper's 0.2; 0, L1 alone)"
          #:default 0.2 #:range (0.0 1.0))
  (option background "--background" "the background's grey level (0 black, the reference's default)"
          #:default 0.0 #:range (0.0 1.0))
  (option iterations "--iterations" "the training iterations (one a frame)" #:default 30000
          #:range (1 1000000))
  (option seed "--seed" "the training views' shuffle's seed" #:default 0)
  (option extent "--extent" "the scene's extent (the manifest's), which scales the position's learning rate"
          #:default 1.0)
  (option shInterval "--sh-interval" "iterations per SH degree (the reference's 1000)" #:default 1000
          #:range (1 1000000))
  (option positionLrInit "--position-lr" "the position's first learning rate, times --extent" #:default 0.00016)
  (option positionLrFinal "--position-lr-final" "the position's last learning rate, times --extent"
          #:default 0.0000016)
  (option positionLrSteps "--position-lr-steps" "the iterations the position's learning rate decays over"
          #:default 30000 #:range (1 1000000))
  (option featureLr "--feature-lr" "the SH DC's learning rate (the other SH bands' is a 20th of it)"
          #:default 0.0025)
  (option opacityLr "--opacity-lr" "the opacity logit's learning rate" #:default 0.025)
  (option scalingLr "--scaling-lr" "the log-scales' learning rate" #:default 0.005)
  (option rotationLr "--rotation-lr" "the quaternion's learning rate" #:default 0.001)
  (option densifyFrom "--densify-from" "densify after this iteration (the reference's 500)" #:default 500
          #:range (0 1000000))
  (option densifyUntil "--densify-until" "densify and reset the opacity before this iteration (the reference's 15000; 0 never)"
          #:default 15000 #:range (0 1000000))
  (option densifyInterval "--densify-interval" "the iterations between densifications (the reference's 100)"
          #:default 100 #:range (1 1000000))
  (option densifyThreshold "--densify-threshold" "the mean 2D-mean gradient norm a splat densifies at (the reference's 0.0002)"
          #:default 0.0002)
  (option percentDense "--percent-dense" "the largest scale a clone has, times --extent (larger ones split; the reference's 0.01)"
          #:default 0.01)
  (option resetInterval "--reset-interval" "the iterations between opacity resets (the reference's 3000); the size prunes start after the first"
          #:default 3000 #:range (1 1000000))
  ;; Required: the reference's code means to prune splats past 20 px on screen after the first
  ;; reset but never does (it clears the radii first), so neither value is the obvious default
  (option maxScreenSize "--max-screen-size" "required: after the first reset, prune a splat whose radius passed this many pixels (the reference's intent, 20; 0 none, what it does)"
          #:default 0 #:range (0 65535) #:given maxScreenSizeGiven))
