;; The training graph's forward and backward passes (Kerbl et al. 2023, Sec. 5 and 6), for one
;; camera per frame: SplatGraph's forward pass (lib/render_graph.zgal's stages 1 to 5, the same
;; kernels), then
;;   6. the loss against the camera's target image: each pixel's loss and its gradient dL/dI with
;;      respect to the pixel's colour I = C + T bg (Loss: the L2 test loss or training's L1 and,
;;      with dssim, lib/ssim.zgal's SSIM kernels adding the D-SSIM term, Sec. 7's
;;      (1 - lambda) L1 + lambda D-SSIM), and their sum;
;;   7. the backward rasterize: each tile's entries back to front (BackwardRasterize), from the
;;      last any of its pixels blended (TileLasts), giving each entry's gradients with respect to
;;      its splat's projection (the 2D mean, the conic, the activated opacity and the colour);
;;   8. the gather: each splat's gradients, the sum of its entries' (InvertEntries finds each of a
;;      splat's entries after the sort, GatherGradients sums them in a fixed order), into
;;      splatGradients;
;;   9. the backward preprocess: each splat's gradients with respect to its parameters
;;      (BackwardPreprocess, lib/splat_backward.zgal's math), into parameterGradients, and the
;;      densification's statistics (densifyStats: the 2D mean's gradient norm and the frames that
;;      saw the splat, accumulated until a densification clears them).
;; No global float atomics anywhere (D4(b)): every entry's gradients are reduced in the tile's
;; workgroup and written once, and every splat's summed by one invocation, so the gradients are
;; the same, bit for bit, on every run. With finiteDifferences, the graph also perturbs one splat's
;; projection (Perturb) and sums the loss's change between a probe's +h and -h frames
;; (LossDelta), for grad_test's finite differences. Programs import it,
;; (import "../../lib/train_graph.zgal"), which imports the render graph and the splat math too. docs/architecture.md has the stages' contracts.

(import "render_graph.zgal")
(import "splat_backward.zgal")  ; ProjectedGradient, preprocessBackward
(import "ssim.zgal")            ; the D-SSIM term's kernels, unpackRgb
(import random)                 ; pcgHash: the split's samples

;; ---------------------------------------------------------------------------------------------
;; Constants
;; ---------------------------------------------------------------------------------------------
;; The most tile entries a training frame holds: 3 x 2^20, so their gradients (gradientStride
;; floats, 36 bytes, an entry) stay within one binding's 128 MiB (108 MiB; docs/architecture.md).
;; TrainGraph says 3145728 too (a graph expression can't name a constant).
(define trainEntryCapacityMax (uint 3145728))

;; A training app's capacity after a frame that needed `total` entries (grownCapacity, at most
;; trainEntryCapacityMax). A frame needing more than trainEntryCapacityMax is truncated, its
;; dropped entries' gradients lost, so a trainer must fail on one (counts' countTotal past
;; trainEntryCapacityMax) rather than step on its gradients.
(define (grownTrainCapacity [capacity : uint] [total : uint]) : uint
  (grownCapacityUpTo capacity total trainEntryCapacityMax))

;; The floats an entry's gradients take in entryGradients, at these offsets
(define gradientStride (uint 9))
(define gradientMean (uint 0))     ; dL/dmean (x, y), per pixel
(define gradientConic (uint 2))    ; dL/dconic (a, b, c): b counts both off-diagonal entries
(define gradientOpacity (uint 5))  ; dL/dopacity, the activated opacity
(define gradientColour (uint 6))   ; dL/dcolour (r, g, b)

;; The backward rasterize's batch: half the forward's, so its shared memory (the batch, and the
;; reduction's scratch) fits in 16 KB; BackwardRasterize's shared arrays say 128 too
(define backwardBatch (uint 128))

;; The loss input's values
;; mean |I - t| over the image's channels (Sec. 7's L1 term), times 1 - dssimWeight with dssim,
;; plus dssimWeight D-SSIM
(define lossL1 (uint 0))
(define lossL2 (uint 1))  ; sum (I - t)^2 over them (smooth: the gradient tests')
;; The mean (clamp(I, 0, 1) - t)^2 over the channels: the evaluation's MSE, for the PSNR (the
;; reference clamps the render to [0, 1] before its PSNR); its dL/dI is 0, so nothing trains on it
(define lossEval (uint 2))

;; The field Perturb changes (0: none): one of the projection's, or perturbParameter plus a
;; parameter's float offset in Splat (0-2 the position, 3 the opacity logit, 4-6 the log-scale,
;; 8-11 the quaternion, 12-59 the SH coefficients; 7, the padding, changes nothing)
(define perturbNone (uint 0))
(define perturbOpacity (uint 1))
(define perturbRed (uint 2))      ; red, green, blue: 2, 3, 4
(define perturbMeanX (uint 5))    ; x, y: 5, 6
(define perturbParameter (uint 16))

;; `losses`, element by element
(define lossTotal (uint 0))   ; the image's loss: the pixels' sum
(define lossProbe (uint 1))   ; with finiteDifferences, the probe this frame ran (a float)
(define lossDelta (uint 2))   ; with finiteDifferences, a -h frame's: the +h side's loss minus its own

;; ---------------------------------------------------------------------------------------------
;; Kernels
;; ---------------------------------------------------------------------------------------------
;; 6. Each pixel's loss and dL/dI, against its target (RGBA8, the red in the low byte, at
;; targetOffset + the pixel's index: docs/data-format.md's images): with lossL2, (I - t)^2 summed
;; over the channels and 2 (I - t); with lossL1, l1Weight |I - t| / (3 pixels) and l1Weight
;; sign(I - t) / (3 pixels), so the sum is the mean times l1Weight (1 - lambda, the D-SSIM term's
;; kernels in lib/ssim.zgal adding lambda D-SSIM after it; 1 without them); with lossEval,
;; (clamp(I, 0, 1) - t)^2 summed over the channels / (3 pixels) (the MSE) and 0. I is the rasterizer's C + T bg, unclamped. A pixel past the targets'
;; targetPixels reads black instead of past the buffer: the app must check the camera's pixels fit
;; (grad_test does, up front); this only keeps a wrong offset from reading out of bounds.
(compute-material Loss
  (workgroup 256)
  (bindings
   (colours (buffer-array vec4 read))
   (targets (buffer-array uint read))
   (pixelGrads (buffer-array vec4 write))   ; dL/dI in .rgb
   (pixelLosses (buffer-array float write)))
  (push (pixels uint) (targetOffset uint) (targetPixels uint) (loss uint) (l1Weight float))
  (compute
   (let* ([scale (/ 1.0 (* 3.0 (float pixels)))])
     (for ([i (range globalInvocationId.x pixels (* entryGroupSize workgroupCount.x))])
       (let* ([colour (.rgb (at colours i))]
              [t (if (< (+ targetOffset i) targetPixels) (unpackRgb (at targets (+ targetOffset i))) (vec3 0.0))]
              [r (- colour t)])
         (when (= loss lossL2)
           (write! (at pixelGrads i) (vec4 (* 2.0 r) 0.0))
           (write! (at pixelLosses i) (dot r r)))
         (when (= loss lossEval)
           (let* ([e (- (clamp colour 0.0 1.0) t)])
             (write! (at pixelGrads i) (vec4 0.0))
             (write! (at pixelLosses i) (* (dot e e) scale))))
         (when (= loss lossL1)
           (write! (at pixelGrads i) (vec4 (* (sign r) (* l1Weight scale)) 0.0))
           (write! (at pixelLosses i) (* (+ (abs r.x) (abs r.y) (abs r.z)) (* l1Weight scale)))))))))

;; 7a. Each tile's [start, last, end): its range, and the entry after the last one any of its pixels
;; blended (the largest of its pixels' lastEntries, at least the start), three uints a tile in
;; backwardRanges, so the backward pass walks only [start, last), and its loop bound stays a
;; buffer's value, the same for the whole workgroup.
(compute-material TileLasts
  (workgroup 64)
  (bindings
   (ranges (buffer-array uint read))         ; two uints a tile: TileRanges
   (lastEntries (buffer-array uint read))
   (backwardRanges (buffer-array uint write)))
  (push (width uint) (height uint) (gridWidth uint) (tileCount uint))
  (compute
   (for ([t (range globalInvocationId.x tileCount (* splatGroupSize workgroupCount.x))])
     (let* ([x0 (* (remainder t gridWidth) tileSize)]
            [y0 (* (/ t gridWidth) tileSize)]
            [start (at ranges (* t (uint 2)))]
            [last (fold ([m start]) ([y (range y0 (min height (+ y0 tileSize)))]
                                     [x (range x0 (min width (+ x0 tileSize)))])
                    (max m (at lastEntries (+ (* y width) x))))])
       (write! (at backwardRanges (* t (uint 3))) start)
       (write! (at backwardRanges (+ (* t (uint 3)) (uint 1))) last)
       (write! (at backwardRanges (+ (* t (uint 3)) (uint 2))) (at ranges (+ (* t (uint 2)) (uint 1))))))))

;; 7b. Each tile's pixels, one invocation each in a 16x16 workgroup per tile as in Rasterize, walk
;; the tile's entries back to front, from each pixel's last blended entry (lastEntries) with its
;; final transmittance (colours' .w), undoing the blend (the reference code's backward pass):
;;   T = T / (1 - alpha), the transmittance before the entry;
;;   dL/dcolour = alpha T dL/dI;
;;   dL/dalpha = T (c - R) . dL/dI - T_final / (1 - alpha) bg . dL/dI, R the colour behind the
;;     entry per unit of transmittance after it (R = alpha' c' + (1 - alpha') R' of the entry
;;     behind it, starting at 0);
;;   with alpha = min(alphaMax, opacity G), G = exp(power) and d = mean - the pixel's centre:
;;   dL/dopacity = G dL/dalpha, dL/dmean = -opacity dL/dalpha G (A d) (A the conic), and
;;   dL/dconic = -opacity dL/dalpha G (d_x^2 / 2, d_x d_y, d_y^2 / 2): the conic's b counts both
;;   off-diagonal entries (tests/oracle/closed_form.h's convention; the reference code's
;;   dL_dconic2D.y is half of it).
;; Where the clamp holds (opacity G > alphaMax), alpha doesn't depend on the opacity, mean or conic,
;; so those gradients are 0 (exact; the reference code passes the gradient through the clamp:
;; docs/paper-conformance.md). Entries the forward pass skipped (alpha < alphaMin, power > 0, the
;; same computation) or didn't reach (from the pixel's last entry on) give a pixel nothing.
;; The workgroup loads the entries in batches of backwardBatch, from the tile's last (TileLasts:
;; entries past it, which no pixel blended, get gradients of 0 without the loop), and for each
;; entry reduces its 256 pixels' gradients in shared memory (each pixel's 9 values, then 16 sums of
;; 16 per value, then 1 of 16), so each entry's gradients are written once (entryGradients, at
;; gradientStride times the entry), in a fixed order: deterministic, and without float atomics.
;; Every invocation runs every loop (their bounds are the tile's), as the barriers need.
(compute-material BackwardRasterize
  (workgroup 16 16)
  (bindings
   (projected (buffer-array Projected read))
   (entrySplats (buffer-array uint read))
   (backwardRanges (buffer-array uint read)) ; three uints a tile: TileLasts
   (colours (buffer-array vec4 read))        ; the final transmittance in .w
   (lastEntries (buffer-array uint read))
   (pixelGrads (buffer-array vec4 read))     ; dL/dI in .rgb
   (entryGradients (buffer-array float write)))
  (push (width uint) (height uint) (background vec3))
  ;; 128 x (8 + 16 + 16) + 9 x 256 x 4 + 9 x 16 x 4 bytes = 14912 (at most 16 KB:
  ;; docs/architecture.md)
  (shared
   (batchMeans (array vec2 128))
   (batchConicOpacities (array vec4 128))  ; the conic (a, b, c) and the opacity
   (batchColours (array vec4 128))
   (scratch (array float 2304))            ; value v of pixel (lane) l at 256 v + l
   (partials (array float 144)))           ; value v's 16 partial sums at 16 v
  (compute
   (let* ([tile (+ (* workgroupId.y workgroupCount.x) workgroupId.x)]
          [tileStart (at backwardRanges (* tile (uint 3)))]
          [tileLast (at backwardRanges (+ (* tile (uint 3)) (uint 1)))]
          [tileEnd (at backwardRanges (+ (* tile (uint 3)) (uint 2)))]
          [lane (+ (* localInvocationId.y tileSize) localInvocationId.x)]
          [pixel globalInvocationId.xy]
          [inside (and (< pixel.x width) (< pixel.y height))]
          [index (+ (* pixel.y width) pixel.x)]
          [centre (+ (vec2 pixel) 0.5)]
          ;; Outside the image: no entries (the last is the tile's start), only loading and reducing
          [final (if inside (at colours index) (vec4 0.0 0.0 0.0 1.0))]
          [last (if inside (at lastEntries index) tileStart)]
          [dIdC (if inside (.rgb (at pixelGrads index)) (vec3 0.0))]
          [bgTerm (dot background dIdC)]
          [batches (/ (+ (- tileLast tileStart) (- backwardBatch (uint 1))) backwardBatch)]
          [(t behind lastAlpha lastColour)
           (fold ([t final.w] [behind (vec3 0.0)] [lastAlpha 0.0] [lastColour (vec3 0.0)])
                 ([b (range (uint 0) batches)])
             ;; Batch b holds [lo, hi): the last backwardBatch entries before the later batches'
             (let* ([hi (- tileLast (* b backwardBatch))]
                    [lo (if (> (- hi tileStart) backwardBatch) (- hi backwardBatch) tileStart)]
                    [n (- hi lo)])
               (when (< lane n)
                 (let* ([p (at projected (at entrySplats (+ lo lane)))])
                   (write! (at batchMeans lane) p.mean)
                   (write! (at batchConicOpacities lane) (vec4 p.conic p.opacity))
                   (write! (at batchColours lane) (vec4 p.colour 0.0))))
               (barrier!)
               (fold ([t t] [behind behind] [lastAlpha lastAlpha] [lastColour lastColour])
                     ([j (range (uint 0) n)])
                 (let* ([k (- n j (uint 1))]
                        [e (+ lo k)]
                        [co (at batchConicOpacities k)]
                        [d (- (at batchMeans k) centre)]
                        ;; As Rasterize computes them, so the same entries are skipped
                        [power (- (* -0.5 (+ (* co.x d.x d.x) (* co.z d.y d.y))) (* co.y d.x d.y))]
                        [g (exp power)]
                        [raw (* co.w g)]
                        [alpha (min alphaMax raw)]
                        [live (and (< e last) (not (or (> power 0.0) (< alpha alphaMin))))]
                        [before (/ t (- 1.0 alpha))]
                        [c (.rgb (at batchColours k))]
                        [nextBehind (+ (* lastAlpha lastColour) (* (- 1.0 lastAlpha) behind))]
                        [dLdAlpha (- (* before (dot (- c nextBehind) dIdC))
                                     (* (/ final.w (- 1.0 alpha)) bgTerm))]
                        ;; The clamp's derivative: 0 where it holds
                        [dLdG (if (> raw alphaMax) 0.0 (* co.w dLdAlpha))]
                        [gdx (* g d.x)]
                        [gdy (* g d.y)]
                        [dMean (* dLdG (vec2 (- (- (* gdx co.x)) (* gdy co.y))
                                             (- (- (* gdy co.z)) (* gdx co.y))))]
                        [dConic (* dLdG (vec3 (* -0.5 gdx d.x) (- (* gdx d.y)) (* -0.5 gdy d.y)))]
                        [dOpacity (if (> raw alphaMax) 0.0 (* g dLdAlpha))]
                        [dColour (* dIdC (* alpha before))]
                        [use (if live 1.0 0.0)])
                   (write! (at scratch (+ (* gradientMean (uint 256)) lane)) (* use dMean.x))
                   (write! (at scratch (+ (* (+ gradientMean (uint 1)) (uint 256)) lane)) (* use dMean.y))
                   (write! (at scratch (+ (* gradientConic (uint 256)) lane)) (* use dConic.x))
                   (write! (at scratch (+ (* (+ gradientConic (uint 1)) (uint 256)) lane)) (* use dConic.y))
                   (write! (at scratch (+ (* (+ gradientConic (uint 2)) (uint 256)) lane)) (* use dConic.z))
                   (write! (at scratch (+ (* gradientOpacity (uint 256)) lane)) (* use dOpacity))
                   (write! (at scratch (+ (* gradientColour (uint 256)) lane)) (* use dColour.x))
                   (write! (at scratch (+ (* (+ gradientColour (uint 1)) (uint 256)) lane)) (* use dColour.y))
                   (write! (at scratch (+ (* (+ gradientColour (uint 2)) (uint 256)) lane)) (* use dColour.z))
                   (barrier!)
                   ;; 144 invocations: value v = lane / 16's lanes 16 (lane % 16) to + 16
                   (when (< lane (* gradientStride (uint 16)))
                     (let* ([base (+ (* (/ lane (uint 16)) (uint 256)) (* (remainder lane (uint 16)) (uint 16)))])
                       (write! (at partials lane) (sum ([i (range (uint 0) (uint 16))]) (at scratch (+ base i))))))
                   (barrier!)
                   ;; 9 invocations: value v = lane's 16 partial sums. The next entry's partials
                   ;; are written after its first barrier, so these reads come first.
                   (when (< lane gradientStride)
                     (write! (at entryGradients (+ (* e gradientStride) lane))
                             (sum ([i (range (uint 0) (uint 16))]) (at partials (+ (* lane (uint 16)) i)))))
                   (if live
                       (values before nextBehind alpha c)
                       (values t behind lastAlpha lastColour))))))])
     ;; Entries past the tile's last (no pixel blended them): their gradients are 0
     (for ([i (range lane (* (- tileEnd tileLast) gradientStride) (* tileSize tileSize))])
       (write! (at entryGradients (+ (* tileLast gradientStride) i)) 0.0))
     ;; The fold's values are only its state
     (when (< t 0.0) (return!)))))

;; 8a. Each sorted entry's position, at the entry's place before the sort (its splat's offset plus
;; its index in the splat's tile rectangle, row by row: EmitEntries' order), from its tile. Places
;; no entry maps to keep the clear's 0xFFFFFFFF (only after a wrapped total; GatherGradients
;; skips them).
(compute-material InvertEntries
  (workgroup 256)
  (bindings
   (projected (buffer-array Projected read))
   (offsets (buffer-array uint read))
   (counts (buffer-array uint read))
   (entryKeys (buffer-array uint read))
   (entrySplats (buffer-array uint read))
   (entryPositions (buffer-array uint write)))
  (push (gridWidth uint))
  (compute
   (let* ([entries (at counts countEntries)]
          [bits (at counts countDepthBits)])
     (for ([e (range globalInvocationId.x entries (* entryGroupSize workgroupCount.x))])
       (let* ([p (at projected (at entrySplats e))]
              [tile (keyTile (at entryKeys e) bits)]
              [tx (remainder tile gridWidth)]
              [ty (/ tile gridWidth)]
              [place (+ (at offsets (at entrySplats e))
                        (* (- ty p.tiles.y) (- p.tiles.z p.tiles.x)) (- tx p.tiles.x))])
         (when (and (>= tx p.tiles.x) (< tx p.tiles.z) (>= ty p.tiles.y) (< ty p.tiles.w)
                    (< place entries))
           (write! (at entryPositions place) e)))))))

;; 8b. Each splat's gradients: its entries' (those the frame holds), summed in the order of its
;; tiles, by one invocation, so the sum is the same every run. Culled splats' are 0.
(compute-material GatherGradients
  (workgroup 64)
  (bindings
   (projected (buffer-array Projected read))
   (offsets (buffer-array uint read))
   (counts (buffer-array uint read))
   (entryPositions (buffer-array uint read))
   (entryGradients (buffer-array float read))
   (splatGradients (buffer-array ProjectedGradient write))
   (splatCounts (buffer-array uint read)))
  (compute
   (let* ([entries (at counts countEntries)])
     (for ([s (range globalInvocationId.x (at splatCounts splatActive) (* splatGroupSize workgroupCount.x))])
       (let* ([first (at offsets s)]
              [(mean conic opacity colour)
               (fold ([mean (vec2 0.0)] [conic (vec3 0.0)] [opacity 0.0] [colour (vec3 0.0)])
                     ([k (range (uint 0) (.tileCount (at projected s)))])
                 (let* ([place (+ first k)]
                        [e (if (< place entries) (at entryPositions place) (bitnot (uint 0)))])
                   (if (< e entries)
                       (let* ([b (* e gradientStride)])
                         (values (+ mean (vec2 (at entryGradients (+ b gradientMean))
                                               (at entryGradients (+ b gradientMean (uint 1)))))
                                 (+ conic (vec3 (at entryGradients (+ b gradientConic))
                                                (at entryGradients (+ b gradientConic (uint 1)))
                                                (at entryGradients (+ b gradientConic (uint 2)))))
                                 (+ opacity (at entryGradients (+ b gradientOpacity)))
                                 (+ colour (vec3 (at entryGradients (+ b gradientColour))
                                                 (at entryGradients (+ b gradientColour (uint 1)))
                                                 (at entryGradients (+ b gradientColour (uint 2)))))))
                       (values mean conic opacity colour))))])
         (write! (at splatGradients s) (ProjectedGradient mean conic opacity colour)))))))

;; A splat's densification statistics (12 bytes; Sec. 5.2): accumulated over the frames since the
;; first or the last densification (which clears them in its frame), for the densification
(struct DensifyStat
  (gradientNorm float)  ; the sum of densifyNorm(dL/dmean) over the frames that saw the splat
  (visible uint)        ; those frames' number
  (maxRadius uint))     ; the largest radius (Projected's, in pixels) it had in them

;; 9. Each splat's gradients with respect to its parameters (parameterGradients, a Splat of
;; gradients: dL/dposition, dL/d(the opacity logit), dL/dlogScale, dL/d(the quaternion as stored)
;; and dL/dsh; the padding isn't written) from its gradients with respect to its projection
;; (splatGradients): lib/splat_backward.zgal's preprocessBackward, one invocation a splat. A culled
;; splat (tileCount 0) gets gradients of 0 and its statistics stay as they were; a visible one adds
;; its densifyNorm to densifyStats, counts the frame and keeps its largest radius.
(compute-material BackwardPreprocess
  (workgroup 64)
  (bindings
   (splats (buffer-array Splat read))
   (cameras (buffer-array Camera read))
   (projected (buffer-array Projected read))
   (splatGradients (buffer-array ProjectedGradient read))
   (parameterGradients (buffer-array Splat write))
   (densifyStats (buffer-array DensifyStat read-write))
   (splatCounts (buffer-array uint read)))
  (push (cameraIndex uint) (shDegree uint))
  (compute
   (let* ([cam (at cameras cameraIndex)])
     (for ([i (range globalInvocationId.x (at splatCounts splatActive) (* splatGroupSize workgroupCount.x))])
       (let* ([visible (> (.tileCount (at projected i)) (uint 0))]
              [g (at splatGradients i)]
              ;; A culled splat's: 0 (preprocessBackward needs a splat projectSplat doesn't cull)
              [r (if visible
                     (preprocessBackward (at splats i) cam shDegree g)
                     (SplatGradient (vec3 0.0) 0.0 (vec3 0.0) (vec4 0.0) (vec3 0.0) (vec3 0.0 0.0 1.0)))])
         (write! (.position (at parameterGradients i)) r.position)
         (write! (.opacity (at parameterGradients i)) r.opacity)
         (write! (.logScale (at parameterGradients i)) r.logScale)
         (write! (.rotation (at parameterGradients i)) r.rotation)
         (for ([k (range (uint 0) (uint 16))])
           (let* ([c (shGradient r k shDegree)])
             (write! (at (.sh (at parameterGradients i)) (* k (uint 3))) c.x)
             (write! (at (.sh (at parameterGradients i)) (+ (* k (uint 3)) (uint 1))) c.y)
             (write! (at (.sh (at parameterGradients i)) (+ (* k (uint 3)) (uint 2))) c.z)))
         (when visible
           (let* ([d (at densifyStats i)])
             (write! (at densifyStats i)
                     (DensifyStat (+ d.gradientNorm (densifyNorm g.mean cam.size)) (+ d.visible (uint 1))
                                  (max d.maxRadius (.radius (at projected i))))))))))))

;; The unit vector along axis i (0-2; none past them)
(define (unit3 [i : uint]) : vec3
  (vec3 (if (= i (uint 0)) 1.0 0.0) (if (= i (uint 1)) 1.0 0.0) (if (= i (uint 2)) 1.0 0.0)))
(define (unit4 [i : uint]) : vec4
  (vec4 (unit3 i) (if (= i (uint 3)) 1.0 0.0)))

;; A splat with delta added to its parameter at float offset (perturbParameter's offsets; the SH
;; coefficients' aren't changed here: projectSplatPerturbed adds delta to them)
(define (perturbedSplat [s : Splat] [offset : uint] [delta : float]) : Splat
  (with s #:position (+ s.position (* (unit3 offset) delta))
        #:opacity (+ s.opacity (if (= offset (uint 3)) delta 0.0))
        #:logScale (+ s.logScale (* (unit3 (- offset (uint 4))) delta))
        #:rotation (+ s.rotation (* (unit4 (- offset (uint 8))) delta))))

;; With finiteDifferences: adds delta to one field of one splat's projection (perturbOpacity and
;; so on), or to one of its parameters (perturbParameter + its offset) and projects it again,
;; after the preprocess (perturbNone changes nothing). Its depth and tiles stay as they were, so
;; the perturbed frame blends the same entries in the same order: the analytic gradients don't see
;; the sort's or the tiles' discrete changes either. A perturbed splat projectSplat would cull
;; keeps its projection (no probe gets that close).
(compute-material Perturb
  (workgroup 1)
  (bindings
   (splats (buffer-array Splat read))
   (cameras (buffer-array Camera read))
   (projected (buffer-array Projected read-write)))
  (push (splatCount uint) (splat uint) (field uint) (delta float) (cameraIndex uint) (near float)
        (shDegree uint))
  (compute
   (when (and (not= field perturbNone) (< splat splatCount))
     (let* ([p (at projected splat)])
       (if (>= field perturbParameter)
           (let* ([offset (- field perturbParameter)]
                  [q (projectSplatPerturbed (perturbedSplat (at splats splat) offset delta)
                                            (at cameras cameraIndex) near shDegree
                                            (if (>= offset (uint 12)) (- offset (uint 12)) (uint 48)) delta)])
             (when (> q.tileCount (uint 0))
               (write! (at projected splat)
                       (with p #:mean q.mean #:conic q.conic #:opacity q.opacity #:colour q.colour))))
           (let* ([unit (vec3 (if (= field perturbRed) 1.0 0.0) (if (= field (+ perturbRed (uint 1))) 1.0 0.0)
                              (if (= field (+ perturbRed (uint 2))) 1.0 0.0))]
                  [shift (vec2 (if (= field perturbMeanX) 1.0 0.0) (if (= field (+ perturbMeanX (uint 1))) 1.0 0.0))])
             (write! (at projected splat)
                     (with p #:opacity (+ p.opacity (if (= field perturbOpacity) delta 0.0))
                           #:colour (+ p.colour (* unit delta))
                           #:mean (+ p.mean (* shift delta))))))))))

;; Whether a splat's projection blends into a pixel at all, as Rasterize decides (alpha against
;; alphaMin, the exponent's sign)
(define (blends [mean : vec2] [conic : vec3] [opacity : float] [centre : vec2]) : bool
  (let* ([d (- mean centre)]
         [power (- (* -0.5 (+ (* conic.x d.x d.x) (* conic.z d.y d.y))) (* conic.y d.x d.y))])
    (not (or (> power 0.0) (< (min alphaMax (* opacity (exp power))) alphaMin)))))

;; With finiteDifferences: a probe runs its +h side, then its -h side (probes 2k + 1 and 2k + 2,
;; probe 0 unperturbed). The +h frames keep each pixel's loss and last entry and the perturbed
;; splat's projection (plusLosses, plusLasts and plusProjected, shared between frames); the -h
;; frame writes each pixel's plus - minus, reduced into losses' lossDelta, so the difference is
;; summed pixel by pixel rather than as the difference of two whole losses. Every frame writes its
;; probe into lossProbe, so the app knows which frame it reads. The loss is discontinuous where a
;; decision flips, and the analytic gradient is the derivative between those jumps, so a pixel
;; where one flips between the sides counts nothing:
;;   - the perturbed splat's alpha crossing alphaMin (it blends into the pixel or not), in its
;;     tiles: this frame's projection against the +h side's;
;;   - the stop at T < 1e-4 moving to another entry (any splat's, as the perturbation changes T):
;;     the pixel's lastEntries differ between the sides.
;; Such pixels are few.
(compute-material LossDelta
  (workgroup 256)
  (bindings
   (projected (buffer-array Projected read))
   (pixelLosses (buffer-array float read))
   (lastEntries (buffer-array uint read))
   (plusLosses (buffer-array float read-write))
   (plusLasts (buffer-array uint read-write))
   (plusProjected (buffer-array Projected read-write))  ; one element
   (lossDeltas (buffer-array float write))
   (losses (buffer-array float write)))
  (push (pixels uint) (width uint) (probe uint) (splatCount uint) (splat uint))
  (compute
   (let* ([plus (= (remainder probe (uint 2)) (uint 1))]
          [minus (and (not= probe (uint 0)) (not plus))]
          [valid (< splat splatCount)]
          [p (at projected (if valid splat (uint 0)))])
     (when (= globalInvocationId.x (uint 0))
       (write! (at losses lossProbe) (float probe))
       (when (and plus valid) (write! (at plusProjected 0) p)))
     ;; plusProjected is read only in -h frames, so no frame reads it while invocation 0 writes it
     (for ([i (range globalInvocationId.x pixels (* entryGroupSize workgroupCount.x))])
       (when plus
         (write! (at plusLosses i) (at pixelLosses i))
         (write! (at plusLasts i) (at lastEntries i)))
       (when (not minus) (write! (at lossDeltas i) 0.0))
       (when minus
         (let* ([other (at plusProjected 0)]
                [x (remainder i width)]
                [y (/ i width)]
                [tx (/ x tileSize)]
                [ty (/ y tileSize)]
                [centre (+ (vec2 (float x) (float y)) 0.5)]
                [inTiles (and valid (> p.tileCount (uint 0)) (>= tx p.tiles.x) (< tx p.tiles.z)
                              (>= ty p.tiles.y) (< ty p.tiles.w))]
                [flips (or (not= (at plusLasts i) (at lastEntries i))
                           (and inTiles
                                (not= (blends p.mean p.conic p.opacity centre)
                                      (blends other.mean other.conic other.opacity centre))))])
           (write! (at lossDeltas i) (if flips 0.0 (- (at plusLosses i) (at pixelLosses i))))))))))

;; Adam (Kingma and Ba 2015) as the reference trains with it: torch.optim.Adam with betas (0.9,
;; 0.999) and eps 1e-15 (gaussian_model.py's training_setup), so with bias corrections b1 = 1 -
;; 0.9^t and b2 = 1 - 0.999^t at step t: m = 0.9 m + 0.1 g, v = 0.999 v + 0.001 g^2,
;; p = p - lr (m / b1) / (sqrt(v / b2) + eps)
(define adamBeta1 0.9)
(define adamBeta2 0.999)
(define adamEpsilon 1e-15)

;; Four parameters' next values and moments
(struct AdamStep (parameter vec4) (m vec4) (v vec4))

(define (adamStep [p : vec4] [g : vec4] [m : vec4] [v : vec4] [lr : vec4] [bias1 : float] [bias2 : float]) : AdamStep
  (let* ([m2 (+ (* adamBeta1 m) (* (- 1.0 adamBeta1) g))]
         [v2 (+ (* adamBeta2 v) (* (- 1.0 adamBeta2) (* g g)))])
    (AdamStep (- p (/ (* lr (/ m2 bias1)) (+ (sqrt (/ v2 bias2)) adamEpsilon))) m2 v2)))

;; 10. One Adam step on every splat's parameters (Splat's fields, the padding left alone) from this
;; frame's parameterGradients, with the moments in adamM and adamV (Splats of moments, shared
;; between frames and cleared in the first). Every splat steps, a culled one too (its gradient is
;; 0, so its moments decay and it keeps moving: torch's Adam does the same). The learning rates are
;; the reference's groups: the position's (decayed by the app), the SH DC's (feature lr), the
;; higher SH coefficients' (feature lr / 20), the opacity logit's, the log-scale's and the
;; quaternion's. A frame whose entries didn't fit (counts' total past its capacity) has lost some
;; entries' gradients, so it doesn't step at all (the app counts such frames: Record marks them).
(compute-material Adam
  (workgroup 64)
  (bindings
   (splats (buffer-array Splat read-write))
   (parameterGradients (buffer-array Splat read))
   (adamM (buffer-array Splat read-write))
   (adamV (buffer-array Splat read-write))
   (counts (buffer-array uint read))
   (splatCounts (buffer-array uint read)))
  (push (bias1 float) (bias2 float) (positionLr float) (dcLr float) (restLr float)
        (opacityLr float) (scalingLr float) (rotationLr float))
  (compute
   (when (<= (at counts countTotal) (at counts countCapacity))
     (for ([i (range globalInvocationId.x (at splatCounts splatActive) (* splatGroupSize workgroupCount.x))])
       (let* ([s (at splats i)]
              [g (at parameterGradients i)]
              [m (at adamM i)]
              [v (at adamV i)]
              ;; The position and the opacity logit together, the log-scale with its padding
              ;; (whose gradient is 0) not written back, and the quaternion
              [a (adamStep (vec4 s.position s.opacity) (vec4 g.position g.opacity) (vec4 m.position m.opacity)
                           (vec4 v.position v.opacity) (vec4 positionLr positionLr positionLr opacityLr) bias1 bias2)]
              [b (adamStep (vec4 s.logScale 0.0) (vec4 g.logScale 0.0) (vec4 m.logScale 0.0) (vec4 v.logScale 0.0)
                           (vec4 scalingLr scalingLr scalingLr 0.0) bias1 bias2)]
              [r (adamStep s.rotation g.rotation m.rotation v.rotation (vec4 rotationLr) bias1 bias2)])
         (write! (.position (at splats i)) a.parameter.xyz)
         (write! (.opacity (at splats i)) a.parameter.w)
         (write! (.position (at adamM i)) a.m.xyz)
         (write! (.opacity (at adamM i)) a.m.w)
         (write! (.position (at adamV i)) a.v.xyz)
         (write! (.opacity (at adamV i)) a.v.w)
         (write! (.logScale (at splats i)) b.parameter.xyz)
         (write! (.logScale (at adamM i)) b.m.xyz)
         (write! (.logScale (at adamV i)) b.v.xyz)
         (write! (.rotation (at splats i)) r.parameter)
         (write! (.rotation (at adamM i)) r.m)
         (write! (.rotation (at adamV i)) r.v)
         ;; The SH coefficients four floats at a time: the first three are the DC's (sh[0..2])
         (for ([j (range (uint 0) (uint 12))])
           (let* ([k (* j (uint 4))]
                  [c (adamStep (vec4 (at s.sh k) (at s.sh (+ k (uint 1))) (at s.sh (+ k (uint 2))) (at s.sh (+ k (uint 3))))
                               (vec4 (at g.sh k) (at g.sh (+ k (uint 1))) (at g.sh (+ k (uint 2))) (at g.sh (+ k (uint 3))))
                               (vec4 (at m.sh k) (at m.sh (+ k (uint 1))) (at m.sh (+ k (uint 2))) (at m.sh (+ k (uint 3))))
                               (vec4 (at v.sh k) (at v.sh (+ k (uint 1))) (at v.sh (+ k (uint 2))) (at v.sh (+ k (uint 3))))
                               (if (= j (uint 0)) (vec4 dcLr dcLr dcLr restLr) (vec4 restLr))
                               bias1 bias2)])
             (write! (at (.sh (at splats i)) k) c.parameter.x)
             (write! (at (.sh (at splats i)) (+ k (uint 1))) c.parameter.y)
             (write! (at (.sh (at splats i)) (+ k (uint 2))) c.parameter.z)
             (write! (at (.sh (at splats i)) (+ k (uint 3))) c.parameter.w)
             (write! (at (.sh (at adamM i)) k) c.m.x)
             (write! (at (.sh (at adamM i)) (+ k (uint 1))) c.m.y)
             (write! (at (.sh (at adamM i)) (+ k (uint 2))) c.m.z)
             (write! (at (.sh (at adamM i)) (+ k (uint 3))) c.m.w)
             (write! (at (.sh (at adamV i)) k) c.v.x)
             (write! (at (.sh (at adamV i)) (+ k (uint 1))) c.v.y)
             (write! (at (.sh (at adamV i)) (+ k (uint 2))) c.v.z)
             (write! (at (.sh (at adamV i)) (+ k (uint 3))) c.v.w))))))))

;; 11. The frame's loss into history[slot] (shared between frames, so the app reads every frame's
;; at the end, though a read event skips older copies), or -1 when the frame's entries didn't fit
;; (counts' total past its capacity: Adam skipped it, and an evaluation frame's loss is wrong)
(compute-material Record
  (workgroup 1)
  (bindings
   (losses (buffer-array float read))
   (counts (buffer-array uint read))
   (history (buffer-array float write)))
  (push (slot uint) (historySize uint))
  (compute
   (when (< slot historySize)
     (write! (at history slot)
             (if (<= (at counts countTotal) (at counts countCapacity)) (at losses lossTotal) -1.0)))))

;; ---------------------------------------------------------------------------------------------
;; 12. Densification and pruning (Sec. 5.2; the reference's densify_and_prune and reset_opacity)
;; ---------------------------------------------------------------------------------------------
;; The splats in use are the first splatCounts[splatActive] of the splat buffer; densification
;; rewrites them in place, in one GPU frame, and the count with them:
;;   DensifyPrepare: the slots' scan count (2 n + 2, for n splats) and the two separators;
;;   DensifyMark: each splat's action (densifyAction) and its slot flags: slots[i] is 1 when it
;;     keeps a place (all but a pruned one), slots[n + 1 + i] when it adds one (a clone, or a
;;     split's second half), slots[n] and slots[2 n + 1] are 0;
;;   an exclusive scan of the 2 n + 2 flags: slots[i] becomes a kept splat's new index, slots[n]
;;     the kept splats' number K, slots[n + 1 + i] an added splat's index (K and the additions
;;     before it: the additions come after the survivors, in their parents' order), and
;;     slots[2 n + 1] the total;
;;   DensifyScatter: the splats from a copy (the previous ones) into their slots, and
;;     DensifyScatterMoments Adam's moments likewise (kept as they were for a kept or cloned splat,
;;     zero for a clone and both halves of a split, as the reference's new parameters start);
;;   DensifyFinish: the count, min(total, capacity), the per-splat dispatch, and the counters.
;; An addition past the capacity (maxSplats) is dropped and counted (splatOverflow): a clone is
;; then not made, and a split not done (the splat stays as it was, with its moments). The app then
;; clears densifyStats in the same frame, so no frame's statistics are lost or counted twice.

;; The actions
(define densifyPrune (uint 0))  ; removed
(define densifyKeep (uint 1))   ; kept as it is
(define densifyClone (uint 2))  ; kept, and a copy added (Sec. 5.2's under-reconstruction)
(define densifySplit (uint 3))  ; replaced by two halves (over-reconstruction)

;; The reference's constants: a split half's scale is the splat's / 1.6; the prune's opacity; the
;; reset's opacity logit, logit(0.01) = ln(0.01 / 0.99), the most the reset leaves
(define splitScaleDivisor 1.6)
(define pruneOpacity 0.005)
(define resetOpacityLogit -4.59512)

;; A splat's mean 2D-mean gradient over the frames that saw it (0 when none did: the reference's
;; NaN is set to 0)
(define (densifyGradient [d : DensifyStat]) : float
  (if (> d.visible (uint 0)) (/ d.gradientNorm (float d.visible)) 0.0))

;; Its largest scale (activated)
(define (maxScale [s : Splat]) : float
  (let* ([e (exp s.logScale)])
    (max e.x (max e.y e.z))))

;; A splat's action. threshold is the gradient's (densify_grad_threshold), cloneScale the largest
;; scale a clone has (percent_dense x extent; larger ones split), pruneScale the largest any splat
;; keeps once screenPrune holds (0.1 x extent), and maxScreenSize the largest radius in pixels it
;; keeps then (the reference's max_screen_size, 20; 0 for none). As the reference: a splat whose
;; opacity is below pruneOpacity is pruned (its halves or clone would be too: they have its
;; opacity), a split's halves are checked against pruneScale (they're 1.6 times smaller), and a
;; clone like its splat. The reference clears max_radii2D before its prune reads it, so its
;; screen-space prune never fires: maxScreenSize 0 is what it does, 20 what it means to
;; (paper-conformance.md). A split's halves aren't checked by radius (theirs isn't known yet).
(define (densifyAction [s : Splat] [d : DensifyStat] [threshold : float] [cloneScale : float]
                       [pruneScale : float] [screenPrune : bool] [maxScreenSize : uint]) : uint
  (let* ([scale (maxScale s)]
         [densify (>= (densifyGradient d) threshold)]
         [split (and densify (> scale cloneScale))]
         [opaque (>= (sigmoid s.opacity) pruneOpacity)]
         [small (if split
                    (<= (/ scale splitScaleDivisor) pruneScale)
                    (and (<= scale pruneScale)
                         (or (= maxScreenSize (uint 0)) (<= d.maxRadius maxScreenSize))))])
    (cond
      [(not (and opaque (or (not screenPrune) small))) densifyPrune]
      [split densifySplit]
      [densify densifyClone]
      [else densifyKeep])))

;; A uniform float in (0, 1] and in [0, 1) from a random uint's top 24 bits, exact in a float
(define (openUnit [r : uint]) : float
  (/ (+ (float (shr r 8)) 1.0) 16777216.0))
(define (halfOpenUnit [r : uint]) : float
  (/ (float (shr r 8)) 16777216.0))

;; Three standard normal samples from a key (Box-Muller on its hashes)
(define (standardNormals [key : uint]) : vec3
  (let* ([h0 (pcgHash key)]
         [h1 (pcgHash h0)]
         [h2 (pcgHash h1)]
         [h3 (pcgHash h2)]
         [r0 (sqrt (* -2.0 (log (openUnit h0))))]
         [a0 (* 6.2831853 (halfOpenUnit h1))]
         [r1 (sqrt (* -2.0 (log (openUnit h2))))]
         [a1 (* 6.2831853 (halfOpenUnit h3))])
    (vec3 (* r0 (cos a0)) (* r0 (sin a0)) (* r1 (cos a1)))))

;; The key of splat i's split half `part` (0 or 1) in a densification seeded with seed
(define (splitKey [seed : uint] [i : uint] [part : uint]) : uint
  (pcgHash (bitxor seed (pcgHash (+ (* i (uint 2)) part)))))

;; A split half's position: a sample of the splat's Gaussian, R (scale x N(0, 1)) + position, as
;; the reference's
(define (splitPosition [s : Splat] [key : uint]) : vec3
  (+ s.position (* (quatToMatrix s.rotation) (* (exp s.logScale) (standardNormals key)))))

;; A split half's log-scale: the scale / 1.6
(define (splitLogScale [logScale : vec3]) : vec3
  (log (/ (exp logScale) splitScaleDivisor)))

;; The prepare: the scan's count and the flags' separators (one invocation)
(compute-material DensifyPrepare
  (workgroup 1)
  (bindings
   (splatCounts (buffer-array uint read-write))
   (slots (buffer-array uint write)))
  (compute
   (let* ([n (at splatCounts splatActive)])
     (write! (at splatCounts splatSlots) (+ (* n (uint 2)) (uint 2)))
     (write! (at slots n) (uint 0))
     (write! (at slots (+ (* n (uint 2)) (uint 1))) (uint 0)))))

;; The mark: each splat's action and flags (screenPrune: 0 or 1)
(compute-material DensifyMark
  (workgroup 64)
  (bindings
   (splats (buffer-array Splat read))
   (densifyStats (buffer-array DensifyStat read))
   (splatCounts (buffer-array uint read))
   (actions (buffer-array uint write))
   (slots (buffer-array uint write)))
  (push (threshold float) (cloneScale float) (pruneScale float) (screenPrune uint) (maxScreenSize uint))
  (compute
   (let* ([n (at splatCounts splatActive)])
     (for ([i (range globalInvocationId.x n (* splatGroupSize workgroupCount.x))])
       (let* ([a (densifyAction (at splats i) (at densifyStats i) threshold cloneScale pruneScale
                                (not= screenPrune (uint 0)) maxScreenSize)])
         (write! (at actions i) a)
         (write! (at slots i) (if (= a densifyPrune) (uint 0) (uint 1)))
         (write! (at slots (+ n (uint 1) i)) (if (> a densifyKeep) (uint 1) (uint 0))))))))

;; The scatter: each splat's (from previous, the splats before) into its slots. capacity is the
;; splat buffer's (maxSplats), seed the split's
(compute-material DensifyScatter
  (workgroup 64)
  (bindings
   (previous (buffer-array Splat read))
   (actions (buffer-array uint read))
   (slots (buffer-array uint read))
   (splatCounts (buffer-array uint read))
   (splats (buffer-array Splat write)))
  (push (capacity uint) (seed uint))
  (compute
   (let* ([n (at splatCounts splatActive)])
     (for ([i (range globalInvocationId.x n (* splatGroupSize workgroupCount.x))])
       (let* ([a (at actions i)]
              [k (at slots i)]
              [e (at slots (+ n (uint 1) i))]
              [fits (< e capacity)]
              [s (at previous i)])
         (when (not= a densifyPrune)
           (write! (at splats k) s)
           (when (and (= a densifySplit) fits)
             (write! (.position (at splats k)) (splitPosition s (splitKey seed i (uint 0))))
             (write! (.logScale (at splats k)) (splitLogScale s.logScale)))
           (when (and (> a densifyKeep) fits)
             (write! (at splats e) s)
             (when (= a densifySplit)
               (write! (.position (at splats e)) (splitPosition s (splitKey seed i (uint 1))))
               (write! (.logScale (at splats e)) (splitLogScale s.logScale))))))))))

;; The moments' scatter (one of Adam's moments, from previous), as DensifyScatter's
(compute-material DensifyScatterMoments
  (workgroup 64)
  (bindings
   (previous (buffer-array Splat read))
   (actions (buffer-array uint read))
   (slots (buffer-array uint read))
   (splatCounts (buffer-array uint read))
   (moments (buffer-array Splat write)))
  (push (capacity uint))
  (compute
   (let* ([n (at splatCounts splatActive)])
     (for ([i (range globalInvocationId.x n (* splatGroupSize workgroupCount.x))])
       (let* ([a (at actions i)]
              [k (at slots i)]
              [e (at slots (+ n (uint 1) i))]
              [fits (< e capacity)])
         (when (not= a densifyPrune)
           (write! (at moments k) (at previous i))
           (when (and (> a densifyKeep) fits)
             ;; The new splat's moments are 0, and a split's other half's too
             (for ([part (range (if (= a densifySplit) (uint 0) (uint 1)) (uint 2))])
               (let* ([j (if (= part (uint 0)) k e)])
                 (write! (.position (at moments j)) (vec3 0.0))
                 (write! (.opacity (at moments j)) 0.0)
                 (write! (.logScale (at moments j)) (vec3 0.0))
                 (write! (.rotation (at moments j)) (vec4 0.0))
                 (for ([c (range (uint 0) (uint 48))])
                   (write! (at (.sh (at moments j)) c) 0.0)))))))))))

;; The finish (one invocation): the count, the counters and the per-splat dispatch
(compute-material DensifyFinish
  (workgroup 1)
  (bindings
   (slots (buffer-array uint read))
   (splatCounts (buffer-array uint read-write))
   (splatCommands (buffer-array DispatchCommand write)))
  (push (capacity uint) (maxGroups uint))
  (compute
   (let* ([n (at splatCounts splatActive)]
          [kept (at slots n)]
          [total (at slots (+ (* n (uint 2)) (uint 1)))]
          [inUse (min total capacity)])
     (write! (at splatCounts splatActive) inUse)
     (write! (at splatCounts splatOverflow) (+ (at splatCounts splatOverflow) (- total inUse)))
     (write! (at splatCounts splatDensifies) (+ (at splatCounts splatDensifies) (uint 1)))
     (write! (at splatCounts splatPruned) (- n kept))
     (write! (at splatCounts splatAdded) (- inUse kept))
     (write! (at splatCommands 0) (DispatchCommand (groupsFor inUse splatGroupSize maxGroups) 1 1)))))

;; The opacity reset (the reference's reset_opacity): every splat's opacity at most 0.01, and its
;; Adam moments zeroed
(compute-material ResetOpacity
  (workgroup 64)
  (bindings
   (splats (buffer-array Splat read-write))
   (adamM (buffer-array Splat write))
   (adamV (buffer-array Splat write))
   (splatCounts (buffer-array uint read)))
  (compute
   (for ([i (range globalInvocationId.x (at splatCounts splatActive) (* splatGroupSize workgroupCount.x))])
     (write! (.opacity (at splats i)) (min (.opacity (at splats i)) resetOpacityLogit))
     (write! (.opacity (at adamM i)) 0.0)
     (write! (.opacity (at adamV i)) 0.0))))

;; ---------------------------------------------------------------------------------------------
;; The graph
;; ---------------------------------------------------------------------------------------------
;; SplatGraph's forward pass (ZGAL has no graph composition, so its nodes are repeated here,
;; without the window and capture) and the backward pass. Its parameters and inputs are
;; SplatGraph's (render_graph.zgal says what they are), and the training's. The camera, its size
;; and the SH degree are per-frame inputs, so a trainer renders a different camera each frame: the
;; buffers are sized to the largest camera (maxWidth x maxHeight, at least every camera's width and
;; height), and the grid, tile and pixel counts are computed each frame in the push constants,
;; invocations and counts that use them (a graph constant is computed once, when it's built).
(graph TrainGraph
  ;; The splats splatFile holds (splatCount), in a buffer of maxSplats (at least splatCount), the
  ;; most the densification may grow them to: ZGAL recreates a buffer whose size changes, losing
  ;; its contents, so the capacity is fixed and the count lives on the GPU (splatCounts)
  (parameter splatCount uint)
  (parameter maxSplats uint)
  (input cameraIndex (per-frame uint))
  (input width (per-frame uint))
  (input height (per-frame uint))
  (input shDegree (per-frame uint))
  (parameter maxWidth uint)
  (parameter maxHeight uint)
  (input splatFile path)
  (input cameraFile path)
  (parameter near float)
  (parameter far float)
  (parameter maxGroups uint)
  ;; Whether the graph also reads back the scene, the projections and the gradients, for tests
  (parameter inspect bool)
  ;; The entries' capacity this frame (at least 1), at most 3145728 (trainEntryCapacityMax): a
  ;; larger one counts as that (counts' countCapacity says so)
  (input capacity (per-frame uint))
  (input background (per-frame vec3))
  ;; The targets (RGBA8 pixels, row by row: an images_<k>.bin), the pixels it holds and the
  ;; camera's first pixel in them (the app checks targetOffset + width x height <= targetPixels)
  (input targetFile path)
  (input targetPixels (per-frame uint))
  (input targetOffset (per-frame uint))
  ;; lossL1, lossL2 or lossEval (per frame: a trainer scores its held-out views with lossEval)
  (input loss (per-frame uint))
  ;; Whether lossL1 frames' loss is (1 - dssimWeight) L1 + dssimWeight D-SSIM (Sec. 7, lambda 0.2;
  ;; lib/ssim.zgal's kernels, with 7 vec4s of scratch a pixel), and lambda, in [0, 1]
  (parameter dssim bool)
  (input dssimWeight (per-frame float))
  ;; Whether the graph perturbs a projection (Perturb) and sums the loss's change (LossDelta) for
  ;; finite differences: probe 0 is unperturbed, any other perturbs field perturbField
  ;; (perturbOpacity and so on, or perturbParameter plus a parameter's offset) of splat
  ;; perturbSplat by perturbDelta, +h for an odd probe and -h (after the same probe's +h frames)
  ;; for an even one
  (parameter finiteDifferences bool)
  (input probe (per-frame uint))
  (input perturbSplat (per-frame uint))
  (input perturbField (per-frame uint))
  (input perturbDelta (per-frame float))
  ;; Whether the graph trains (splat_train): Adam steps the splats in place after the backward pass
  ;; (adamM and adamV its moments), and Record writes each frame's loss into history[historySlot]
  ;; (historySize slots); the app passes Adam's bias corrections (1 - 0.9^t and 1 - 0.999^t at
  ;; step t) and the learning rates
  (parameter train bool)
  (parameter historySize uint)
  (input historySlot (per-frame uint))
  (input bias1 (per-frame float))
  (input bias2 (per-frame float))
  (input positionLr (per-frame float))
  (input dcLr (per-frame float))
  (input restLr (per-frame float))
  (input opacityLr (per-frame float))
  (input scalingLr (per-frame float))
  (input rotationLr (per-frame float))
  ;; The densification's (with train; the app enables its nodes, densify*, in a densification's
  ;; frame, and resetOpacity in a reset's): densifyAction's gradient threshold, the largest scale
  ;; a clone has and the largest a splat keeps, whether the size prunes apply (0 or 1), the
  ;; largest radius in pixels a splat keeps then (0: no screen-space prune), and the split's seed
  ;; (a new one each densification). Per frame, so a test can set them from the statistics it read
  (input densifyThreshold (per-frame float))
  (input cloneScale (per-frame float))
  (input pruneScale (per-frame float))
  (input screenPrune (per-frame uint))
  (input maxScreenSize (per-frame uint))
  (input densifySeed (per-frame uint))

  ;; The buffers' sizes; this frame's are (/ (+ width 15) 16) and so on, written out where used
  (constant maxTileCount (* (/ (+ maxWidth 15) 16) (/ (+ maxHeight 15) 16)))
  (constant maxPixels (* maxWidth maxHeight))

  ;; The splats: the file's, copied once into the first splatCount of `splats`
  (buffer-file splatSource Splat splatFile)
  (buffer splats Splat maxSplats #:frames shared)
  (buffer-file cameras Camera cameraFile)
  (buffer-file targets uint targetFile)
  (buffer projected Projected maxSplats #:frames per-frame)
  (buffer tileCounts uint maxSplats #:frames per-frame)
  (buffer offsets uint maxSplats #:frames per-frame)
  (buffer counts uint 5 #:frames per-frame)  ; countSize
  (buffer commands DispatchCommand 1 #:frames per-frame)
  (buffer splatCounts uint 6 #:frames shared)  ; splatCountsSize
  (buffer splatCommands DispatchCommand 1 #:frames shared)
  (buffer entryKeys uint (min capacity 3145728) #:frames per-frame)
  (buffer entrySplats uint (min capacity 3145728) #:frames per-frame)
  (buffer ranges uint (* maxTileCount 2) #:frames per-frame)
  (buffer backwardRanges uint (* maxTileCount 3) #:frames per-frame)
  (buffer colours vec4 maxPixels #:frames per-frame)
  (buffer lastEntries uint maxPixels #:frames per-frame)
  (image rendered rgba8 (fixed maxWidth maxHeight) #:frames per-frame)
  ;; The backward pass's
  (buffer pixelGrads vec4 maxPixels #:frames per-frame)
  (buffer pixelLosses float maxPixels #:frames per-frame)
  (buffer losses float 3 #:frames per-frame)  ; lossTotal, lossProbe, lossDelta
  ;; The D-SSIM term's scratch: shared, as the graph orders a frame's use after the previous
  ;; frame's conflicting use (FrameMode::Shared, GraphTypes.h), and in training the frames are
  ;; serial anyway, so per-frame copies would only cost memory; dead after the loss
  (buffer ssimRowsR vec4 maxPixels #:frames shared #:when dssim)
  (buffer ssimRowsG vec4 maxPixels #:frames shared #:when dssim)
  (buffer ssimRowsB vec4 maxPixels #:frames shared #:when dssim)
  (buffer ssimRowsCross vec4 maxPixels #:frames shared #:when dssim)
  (buffer ssimPartialsR vec4 maxPixels #:frames shared #:when dssim)
  (buffer ssimPartialsG vec4 maxPixels #:frames shared #:when dssim)
  (buffer ssimPartialsB vec4 maxPixels #:frames shared #:when dssim)
  (buffer entryGradients float (* (min capacity 3145728) 9) #:frames per-frame)  ; gradientStride
  (buffer entryPositions uint (min capacity 3145728) #:frames per-frame)
  (buffer splatGradients ProjectedGradient maxSplats #:frames per-frame)
  (buffer parameterGradients Splat maxSplats #:frames per-frame)
  ;; Accumulated across frames, so shared: cleared in the graph's first frame (resetDensify) and by
  ;; each densification, in its frame (densifyClear)
  (buffer densifyStats DensifyStat maxSplats #:frames shared)
  ;; Finite differences': the +h side's, shared, so the -h frames see the last +h frame's
  (buffer plusLosses float maxPixels #:frames shared #:when finiteDifferences)
  (buffer plusLasts uint maxPixels #:frames shared #:when finiteDifferences)
  (buffer plusProjected Projected 1 #:frames shared #:when finiteDifferences)
  (buffer lossDeltas float maxPixels #:frames per-frame #:when finiteDifferences)
  ;; Training's, across frames
  (buffer adamM Splat maxSplats #:frames shared #:when train)
  (buffer adamV Splat maxSplats #:frames shared #:when train)
  (buffer history float (max historySize 1) #:frames shared #:when train)
  ;; The densification's, within its frame: each splat's action, and its slots (2 maxSplats + 2).
  ;; Its copy of the splats and of each moment before it is parameterGradients (dead after Adam,
  ;; which doesn't run in a densification's frame), so it needs no 240 B a splat more
  (buffer actions uint maxSplats #:frames shared #:when train)
  (buffer slots uint (+ (* maxSplats 2) 2) #:frames shared #:when train)

  (material initializing InitSplatCounts splatCounts splatCommands
            #:push ((splatCount splatCount) (maxGroups maxGroups)) #:invocations (1))
  (material preprocessing Preprocess splats cameras projected tileCounts splatCounts
            #:push ((cameraIndex cameraIndex) (near near) (shDegree shDegree)))
  (material perturbing Perturb splats cameras projected
            #:push ((splatCount splatCount) (splat perturbSplat) (field perturbField) (delta perturbDelta)
                    (cameraIndex cameraIndex) (near near) (shDegree shDegree))
            #:invocations (1) #:when finiteDifferences)
  (material preparing DensifyPrepare splatCounts slots #:invocations (1) #:when train)
  (material marking DensifyMark splats densifyStats splatCounts actions slots
            #:push ((threshold densifyThreshold) (cloneScale cloneScale) (pruneScale pruneScale)
                    (screenPrune screenPrune) (maxScreenSize maxScreenSize))
            #:when train)
  (material scattering DensifyScatter (previous parameterGradients) actions slots splatCounts splats
            #:push ((capacity maxSplats) (seed densifySeed)) #:when train)
  (material scatteringFirst DensifyScatterMoments (previous parameterGradients) actions slots splatCounts (moments adamM)
            #:push ((capacity maxSplats)) #:when train)
  (material scatteringSecond DensifyScatterMoments (previous parameterGradients) actions slots splatCounts (moments adamV)
            #:push ((capacity maxSplats)) #:when train)
  (material finishing DensifyFinish slots splatCounts splatCommands
            #:push ((capacity maxSplats) (maxGroups maxGroups)) #:invocations (1) #:when train)
  (material resetting ResetOpacity splats adamM adamV splatCounts #:when train)
  (material planning PlanEntries counts commands
            #:push ((capacity (min capacity 3145728)) (tileCount (* (/ (+ width 15) 16) (/ (+ height 15) 16))) (near near) (far far)
                    (maxGroups maxGroups))
            #:invocations (1))
  (material emitting EmitEntries projected offsets counts entryKeys entrySplats splatCounts
            #:push ((gridWidth (/ (+ width 15) 16)) (near near) (far far)))
  (material ranging TileRanges entryKeys counts ranges #:push ((tileCount (* (/ (+ width 15) 16) (/ (+ height 15) 16)))))
  (material rasterizing Rasterize projected entrySplats ranges colours lastEntries rendered
            #:push ((width width) (height height) (background background))
            #:invocations ((* (/ (+ width 15) 16) 16) (* (/ (+ height 15) 16) 16)))  ; 16: tileSize, a workgroup a tile
  (material scoring Loss colours targets pixelGrads pixelLosses
            #:push ((pixels (* width height)) (targetOffset targetOffset) (targetPixels targetPixels) (loss loss)
                    (l1Weight (if dssim (- 1.0 dssimWeight) 1.0)))
            #:invocations ((min (* width height) (* (max maxGroups 1) 256))))  ; 256: its workgroup size
  ;; The D-SSIM kernels' weight: lambda in lossL1 frames (0: lossL1), 0 (idle) in the others
  (material ssimRowing SsimRows colours targets (rowsR ssimRowsR) (rowsG ssimRowsG) (rowsB ssimRowsB)
            (rowsCross ssimRowsCross)
            #:push ((width width) (height height) (targetOffset targetOffset) (targetPixels targetPixels)
                    (weight (if (= loss 0) dssimWeight 0.0)))
            #:invocations ((min (* width height) (* (max maxGroups 1) 256))) #:when dssim)
  (material ssimColumning SsimColumns (rowsR ssimRowsR) (rowsG ssimRowsG) (rowsB ssimRowsB)
            (rowsCross ssimRowsCross) (partialsR ssimPartialsR) (partialsG ssimPartialsG)
            (partialsB ssimPartialsB) pixelLosses
            #:push ((width width) (height height) (weight (if (= loss 0) dssimWeight 0.0)))
            #:invocations ((min (* width height) (* (max maxGroups 1) 256))) #:when dssim)
  (material ssimGradRowing SsimGradRows (partialsR ssimPartialsR) (partialsG ssimPartialsG)
            (partialsB ssimPartialsB) (rowsR ssimRowsR) (rowsG ssimRowsG) (rowsB ssimRowsB)
            #:push ((width width) (height height) (weight (if (= loss 0) dssimWeight 0.0)))
            #:invocations ((min (* width height) (* (max maxGroups 1) 256))) #:when dssim)
  (material ssimGradColumning SsimGradColumns (rowsR ssimRowsR) (rowsG ssimRowsG) (rowsB ssimRowsB)
            colours targets pixelGrads
            #:push ((width width) (height height) (targetOffset targetOffset) (targetPixels targetPixels)
                    (weight (if (= loss 0) dssimWeight 0.0)))
            #:invocations ((min (* width height) (* (max maxGroups 1) 256))) #:when dssim)
  (material differencing LossDelta projected pixelLosses lastEntries plusLosses plusLasts plusProjected
            lossDeltas losses
            #:push ((pixels (* width height)) (width width) (probe probe) (splatCount splatCount) (splat perturbSplat))
            #:invocations ((min (* width height) (* (max maxGroups 1) 256))) #:when finiteDifferences)
  (material lasting TileLasts ranges lastEntries backwardRanges
            #:push ((width width) (height height) (gridWidth (/ (+ width 15) 16)) (tileCount (* (/ (+ width 15) 16) (/ (+ height 15) 16))))
            #:invocations ((min (* (/ (+ width 15) 16) (/ (+ height 15) 16)) (* (max maxGroups 1) 64))))  ; 64: its workgroup size
  (material backward BackwardRasterize projected entrySplats backwardRanges colours lastEntries pixelGrads
            entryGradients
            #:push ((width width) (height height) (background background))
            #:invocations ((* (/ (+ width 15) 16) 16) (* (/ (+ height 15) 16) 16)))
  (material inverting InvertEntries projected offsets counts entryKeys entrySplats entryPositions
            #:push ((gridWidth (/ (+ width 15) 16))))
  (material gathering GatherGradients projected offsets counts entryPositions entryGradients
            splatGradients splatCounts)
  (material backwardPreprocessing BackwardPreprocess splats cameras projected splatGradients
            parameterGradients densifyStats splatCounts
            #:push ((cameraIndex cameraIndex) (shDegree shDegree)))
  (material stepping Adam splats parameterGradients adamM adamV counts splatCounts
            #:push ((bias1 bias1) (bias2 bias2) (positionLr positionLr) (dcLr dcLr)
                    (restLr restLr) (opacityLr opacityLr) (scalingLr scalingLr) (rotationLr rotationLr))
            #:when train)
  (material recording Record losses counts history
            #:push ((slot historySlot) (historySize historySize))
            #:invocations (1) #:when train)

  ;; The splats and their count, in the first frame
  (copy loadSplats splatSource splats #:once #t)
  (dispatch initSplats initializing #:once #t)
  ;; The forward pass: SplatGraph's, over the splats in use
  (dispatch preprocess preprocessing #:indirect (at splatCommands 0))
  (dispatch perturb perturbing #:when finiteDifferences)
  (exclusive-scan scanTileCounts tileCounts offsets #:op add #:count (at splatCounts 0))  ; splatActive
  (reduce totalTileCounts tileCounts (at counts 1) #:op add #:count (at splatCounts 0))
  (dispatch plan planning)
  (dispatch emit emitting #:indirect (at commands 0))
  (sort sortEntries entryKeys #:values entrySplats #:count (at counts 0))
  (clear clearRanges ranges)
  (dispatch findRanges ranging #:indirect (at commands 0))
  (dispatch rasterize rasterizing)
  ;; The loss
  (dispatch score scoring)
  (dispatch ssimRows ssimRowing #:when dssim)
  (dispatch ssimColumns ssimColumning #:when dssim)
  (dispatch ssimGradRows ssimGradRowing #:when dssim)
  (dispatch ssimGradColumns ssimGradColumning #:when dssim)
  (reduce totalLoss pixelLosses (at losses 0) #:op add #:count (* width height))  ; lossTotal
  (dispatch difference differencing #:when finiteDifferences)
  (reduce totalDelta lossDeltas (at losses 2) #:op add #:count (* width height) #:when finiteDifferences)
  ;; The backward pass
  (dispatch findLasts lasting)
  (dispatch backwardRasterize backward)
  (clear clearPositions entryPositions #:value 4294967295)
  (dispatch invert inverting #:indirect (at commands 0))
  (dispatch gather gathering #:indirect (at splatCommands 0))
  (clear resetDensify densifyStats #:once #t)
  (dispatch backwardPreprocess backwardPreprocessing #:indirect (at splatCommands 0))
  ;; Training
  (clear resetFirstMoments adamM #:once #t #:when train)
  (clear resetSecondMoments adamV #:once #t #:when train)
  (clear resetHistory history #:once #t #:when train)
  (dispatch adam stepping #:indirect (at splatCommands 0) #:when train)
  (dispatch record recording #:when train)
  ;; The densification and the opacity reset (12): off until the app enables them in a frame,
  ;; after the backward pass (whose statistics they include) and instead of Adam
  (dispatch densifyPrepare preparing #:enabled #f #:when train)
  (dispatch densifyMark marking #:indirect (at splatCommands 0) #:enabled #f #:when train)
  (exclusive-scan densifyScan slots slots #:op add #:count (at splatCounts 2) #:enabled #f #:when train)  ; splatSlots
  (copy densifyCopySplats splats parameterGradients #:enabled #f #:when train)
  (dispatch densifyScatter scattering #:indirect (at splatCommands 0) #:enabled #f #:when train)
  (copy densifyCopyFirstMoments adamM parameterGradients #:enabled #f #:when train)
  (dispatch densifyScatterFirst scatteringFirst #:indirect (at splatCommands 0) #:enabled #f #:when train)
  (copy densifyCopySecondMoments adamV parameterGradients #:enabled #f #:when train)
  (dispatch densifyScatterSecond scatteringSecond #:indirect (at splatCommands 0) #:enabled #f #:when train)
  (dispatch densifyFinish finishing #:enabled #f #:when train)
  (clear densifyClear densifyStats #:enabled #f #:when train)
  (dispatch resetOpacity resetting #:indirect (at splatCommands 0) #:enabled #f #:when train)

  (readback readCounts counts)
  (readback readLosses losses)
  (readback readSplatGradients splatGradients #:when inspect)
  (readback readParameterGradients parameterGradients #:when inspect)
  (readback readDensifyStats densifyStats #:when inspect)
  (readback readBackwardRanges backwardRanges #:when inspect)
  (readback readSplats splats #:once #t #:when inspect)
  (readback readCameras cameras #:once #t #:when (or inspect train))
  (readback readHistory history #:when train)
  (readback readTrained splats #:when train)
  (readback readSplatCounts splatCounts)
  ;; The densification's, for its test (programs/densify_test)
  (readback readFirstMoments adamM #:when (and inspect train))
  (readback readSecondMoments adamV #:when (and inspect train))
  (readback readActions actions #:when (and inspect train))
  (readback readSlots slots #:when (and inspect train))
  (readback readProjected projected #:when inspect))
